+bool CPlayerCache::CollectInventorySortItems(BYTE scope, BYTE bankIndex, std::vector<sITEM_DATA*>& items)
+{
+    items.clear();
+    if (scope == 0 && bankIndex == 255)
+    {
+        for (const auto& pair : m_mapItems)
+        {
+            sITEM_DATA* item = pair.second;
+            if (!item) return false;
+            if (item->byPlace >= CONTAINER_TYPE_BAG1 && item->byPlace <= CONTAINER_TYPE_BAG5)
+                items.push_back(item);
+        }
+    }
+    else if (scope == 2 && bankIndex < 3 && IsBankLoaded())
+    {
+        bool hasBank = false;
+        for (const auto& pair : m_mapBank)
+        {
+            sITEM_DATA* item = pair.second;
+            if (!item) return false;
+            if (item->byPlace == CONTAINER_TYPE_BANKSLOT && item->byPosition == bankIndex) hasBank = true;
+            if (item->byPlace == CONTAINER_TYPE_BANK1 + bankIndex) items.push_back(item);
+        }
+        if (!hasBank) return false;
+    }
+    else return false;
+    return items.size() <= 160;
+}
