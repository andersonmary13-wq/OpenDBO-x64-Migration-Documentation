+
+// Main/UI thread only. Keep restore attempts across GUI recreation, not logins.
+namespace
+{
+    unsigned long long g_characterPreferenceEpoch = 0;
+    unsigned long long g_mascotPreferenceAttempt = 0;
+    unsigned long long g_fuelPreferenceAttempt = 0;
+    unsigned int g_fuelPreferenceVehicle = 0xffffffff;
+}
+
+unsigned long long NtlCharacterPreferenceEpoch()
+{
+    return g_characterPreferenceEpoch;
+}
+
+void NtlBeginCharacterPreferenceSession()
+{
+    if (++g_characterPreferenceEpoch == 0) ++g_characterPreferenceEpoch;
+    g_mascotPreferenceAttempt = 0;
+    g_fuelPreferenceAttempt = 0;
+    g_fuelPreferenceVehicle = 0xffffffff;
+}
+
+bool NtlMarkMascotPreferenceAttempt(unsigned long long epoch)
+{
+    if (!epoch || epoch != g_characterPreferenceEpoch || g_mascotPreferenceAttempt == epoch)
+        return false;
+    g_mascotPreferenceAttempt = epoch;
+    return true;
+}
+
+bool NtlMarkFuelPreferenceAttempt(unsigned long long epoch, unsigned int vehicleSerial)
+{
+    if (!epoch || epoch != g_characterPreferenceEpoch || vehicleSerial == 0xffffffff)
+        return false;
+    if (g_fuelPreferenceAttempt == epoch && g_fuelPreferenceVehicle == vehicleSerial)
+        return false;
+    g_fuelPreferenceAttempt = epoch;
+    g_fuelPreferenceVehicle = vehicleSerial;
+    return true;
+}
