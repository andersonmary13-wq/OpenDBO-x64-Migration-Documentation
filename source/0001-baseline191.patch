+
+VOID CQuickSlotGui::ResetDeferredSortBindings(VOID)
+{
+    for (RwInt32 row = 0; row < QUICKSLOT_MAXROW; ++row)
+        for (RwInt32 col = 0; col < QUICKSLOT_MAXCOL; ++col)
+            m_abDeferredSortBinding[row][col] = FALSE;
+    m_hDeferredSortAvatar = INVALID_SERIAL_ID;
+    m_uiDeferredSortSocket = static_cast<RwUInt64>(INVALID_HSERVER);
+    m_uiDeferredSortGeneration = ++s_quickSlotSortBindingGeneration;
+}
+
+RwBool CQuickSlotGui::IsDeferredSortContextCurrent(VOID)
+{
+    if (!GetDboGlobal() || !GetNtlSLGlobal())
+        return FALSE;
+    CNtlSobAvatar* pAvatar = GetNtlSLGlobal()->GetSobAvatar();
+    const SConnectAtomic& connection = GetDboGlobal()->GetConnectData()->sGameCon;
+    return pAvatar && pAvatar->GetSerialID() == m_hDeferredSortAvatar
+        && connection.byConnState == SConnectAtomic::SOCKET_STATE_CONNECT
+        && connection.hSocket != INVALID_HSERVER
+        && static_cast<RwUInt64>(connection.hSocket) == m_uiDeferredSortSocket;
+}
+
+VOID CQuickSlotGui::DeferSortBinding(RwInt32 nRow, RwInt32 nCol)
+{
+    if (nRow < 0 || nRow >= QUICKSLOT_MAXROW || nCol < 0 || nCol >= QUICKSLOT_MAXCOL)
+        return;
+    if (m_hDeferredSortAvatar != INVALID_SERIAL_ID && !IsDeferredSortContextCurrent())
+        ResetDeferredSortBindings();
+    CNtlSobAvatar* pAvatar = GetNtlSLGlobal()->GetSobAvatar();
+    const SConnectAtomic& connection = GetDboGlobal()->GetConnectData()->sGameCon;
+    if (!pAvatar || connection.byConnState != SConnectAtomic::SOCKET_STATE_CONNECT
+        || connection.hSocket == INVALID_HSERVER)
+        return;
+    m_hDeferredSortAvatar = pAvatar->GetSerialID();
+    m_uiDeferredSortSocket = static_cast<RwUInt64>(connection.hSocket);
+    m_abDeferredSortBinding[nRow][nCol] = TRUE;
+}
+
+VOID CQuickSlotGui::FlushDeferredSortBindings(VOID)
+{
+    if (m_hDeferredSortAvatar == INVALID_SERIAL_ID)
+        return;
+    if (!IsDeferredSortContextCurrent())
+    {
+        ResetDeferredSortBindings();
+        return;
+    }
+    if (GetDboGlobal()->GetGamePacketGenerator()->IsInventorySortPending())
+        return;
+    const RwUInt64 generation = m_uiDeferredSortGeneration;
+    for (RwInt32 row = 0; row < QUICKSLOT_MAXROW; ++row)
+    {
+        for (RwInt32 col = 0; col < QUICKSLOT_MAXCOL; ++col)
+        {
+            // Packet callbacks may reset the session or replace/destroy this GUI.
+            if (GetDialogManager()->GetDialog(DIALOG_QUICKSLOT) != this)
+                return;
+            if (m_uiDeferredSortGeneration != generation)
+                return;
+            if (!IsDeferredSortContextCurrent())
+            {
+                ResetDeferredSortBindings();
+                return;
+            }
+            if (GetDboGlobal()->GetGamePacketGenerator()->IsInventorySortPending())
+                return;
+            if (!m_abDeferredSortBinding[row][col])
+                continue;
+
+            CQuickSlotItem& slot = m_aQuickSlotItem[row][col];
+            if (slot.IsValid() && !slot.IsItem())
+            {
+                m_abDeferredSortBinding[row][col] = FALSE;
+                continue;
+            }
+            RwUInt32 tableIndex = INVALID_DWORD;
+            RwUInt8 place = INVALID_BYTE, position = INVALID_BYTE;
+            const RwBool bEmpty = !slot.IsValid();
+            if (!bEmpty)
+            {
+                const RwUInt32 serial = slot.GetFirstSerialID();
+                CNtlSob* pObject = GetNtlSobManager()->GetSobObject(serial);
+                if (!pObject || pObject->GetClassID() != SLCLASS_SLOT_ITEM)
+                    continue;
+                CNtlSobItem* pItem = reinterpret_cast<CNtlSobItem*>(pObject);
+                if (pItem->GetIcon() != slot.GetFirstIcon()
+                    || pItem->GetItemPosition() != CNtlSobItem::SIP_BAG_CHILD)
+                    continue;
+                CNtlSob* pParentObject = GetNtlSobManager()->GetSobObject(pItem->GetParentItemSerial());
+                if (!pParentObject || pParentObject->GetClassID() != SLCLASS_SLOT_ITEM)
+                    continue;
+                CNtlSobItem* pParent = reinterpret_cast<CNtlSobItem*>(pParentObject);
+                const RwInt32 bag = pParent->GetItemSlotIdx();
+                const RwInt32 cell = pItem->GetItemSlotIdx();
+                if (pParent->GetItemPosition() != CNtlSobItem::SIP_BAG
+                    || bag < 0 || bag >= NTL_MAX_BAGSLOT_COUNT || cell < 0 || cell >= pParent->GetChildNum()
+                    || GetNtlSLGlobal()->GetSobAvatar()->GetInventory()->GetBagItem(bag) != pParent->GetSerialID()
+                    || pParent->GetChildSerial(cell) != serial || !pItem->GetSobAttr())
+                    continue;
+                CNtlSobItemAttr* pAttr = reinterpret_cast<CNtlSobItemAttr*>(pItem->GetSobAttr());
+                tableIndex = pAttr->GetTblIdx();
+                place = static_cast<RwUInt8>(CONTAINER_TYPE_BAG1 + bag);
+                position = static_cast<RwUInt8>(cell);
+            }
+
+            // Clear before sending; reentrant edits must not be overwritten afterwards.
+            m_abDeferredSortBinding[row][col] = FALSE;
+            const RwUInt8 quickSlot = static_cast<RwUInt8>(ROWCOL_TO_SLOTID(row, col));
+            if (bEmpty)
+                GetDboGlobal()->GetGamePacketGenerator()->SendUnsetIconFromQuickSlot(quickSlot);
+            else
+                GetDboGlobal()->GetGamePacketGenerator()->SendSetIconToQuickSlot(tableIndex,
+                    quickSlot, QUICK_SLOT_TYPE_ITEM, place, position);
+            if (GetDialogManager()->GetDialog(DIALOG_QUICKSLOT) != this)
+                return;
+            if (m_uiDeferredSortGeneration != generation)
+                return;
+        }
+    }
