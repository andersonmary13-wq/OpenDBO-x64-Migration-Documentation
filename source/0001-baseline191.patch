+VOID CWorldMapGui::RebuildNpcSearchResults()
+{
+	if (!m_pcbbSearchNpc) return;
+	std::vector<TBLIDX> visible(m_vecNpcSearchEligible);
+	MapTrace24NpcVisible(visible.size());
+	if (visible == m_vecNpcSearchVisible) return;
+	const ULONGLONG guiStarted = MapTrace24Tick();
+	const TBLIDX selected = m_uiSelectedSearchNpc;
+	const RwReal elapsed = m_fNpcSearchPulseElapsed;
+	const RwUInt8 step = m_byNpcSearchPulseStep;
+	m_vecNpcSearchVisible.swap(visible);
+	m_pcbbSearchNpc->ClearAllItems();
+	m_pcbbSearchNpc->AddItem(GetDisplayStringManager()->GetString("DST_WORLDMAP_SEARCH_NPC_TITLE"), INVALID_TBLIDX);
+	RwInt32 selectedIndex = 0;
+	for (size_t i = 0; i < m_vecNpcSearchVisible.size(); ++i)
+	{
+		const TBLIDX id = m_vecNpcSearchVisible[i];
+		m_pcbbSearchNpc->AddItem(m_mapNpcSearch.find(id)->second.wstrName.c_str(), id);
+		if (id == selected) selectedIndex = static_cast<RwInt32>(i + 1);
+	}
+	ResetNpcSearchSelection();
+	if (selectedIndex > 0)
+	{
+		m_pcbbSearchNpc->SelectItem(selectedIndex);
+		OnSelectedSearchNpc(selectedIndex);
+		m_fNpcSearchPulseElapsed = elapsed;
+		m_byNpcSearchPulseStep = step;
+		ApplyNpcSearchPulse();
+	}
+	if (g_mapTrace24) { g_mapTrace24->guiMs += ::GetTickCount64() - guiStarted; g_mapTrace24->guiAdds += static_cast<unsigned int>(m_vecNpcSearchVisible.size() + 1); }
+}
+
+VOID CWorldMapGui::RefreshNpcSearchChoices()
+{
+	const ULONGLONG eligibilityStarted = MapTrace24Tick();
+	std::vector<TBLIDX> eligible;
+	eligible.reserve(m_vecNpcSearchOrder.size());
+	for (std::vector<TBLIDX>::const_iterator it = m_vecNpcSearchOrder.begin(); it != m_vecNpcSearchOrder.end(); ++it)
+	{
+		std::map<TBLIDX, sNPC_SEARCH_ENTRY>::const_iterator entry = m_mapNpcSearch.find(*it);
+		if (entry != m_mapNpcSearch.end() && (!entry->second.bQuestOnly || IsNpcSearchQuestRelevant(*it)))
+			eligible.push_back(*it);
+	}
+	m_vecNpcSearchEligible.swap(eligible);
+	if (g_mapTrace24) g_mapTrace24->eligibilityMs += ::GetTickCount64() - eligibilityStarted;
+	RebuildNpcSearchResults();
+}
