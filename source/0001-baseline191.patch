+namespace
+{
+    bool AtomicSqlStartsWith(const std::string& sql, const char* verb)
+    {
+        const size_t n = strlen(verb);
+        return sql.size() > n && _strnicmp(sql.c_str(), verb, n) == 0
+            && (sql[n] == ' ' || sql[n] == '\t' || sql[n] == '\r' || sql[n] == '\n');
+    }
+}
+
+bool DatabaseAtomicTransaction::Query(const std::string& sql, QueryResult*& result)
+{
+    result = nullptr;
+    if (m_failed || !AtomicSqlStartsWith(sql, "SELECT")) { m_failed = true; return false; }
+    if (!m_db._AtomicSendNoRetry(m_connection, sql.c_str())
+        || !m_db._AtomicStoreResult(m_connection, result))
+    { m_failed = true; return false; }
+    return true; // A successful SELECT of zero rows returns nullptr.
+}
+
+bool DatabaseAtomicTransaction::ExecuteExact(const std::string& sql, UINT64 expectedAffectedRows)
+{
+    if (m_failed || !(AtomicSqlStartsWith(sql, "UPDATE") || AtomicSqlStartsWith(sql, "DELETE")
+        || AtomicSqlStartsWith(sql, "INSERT"))) { m_failed = true; return false; }
+    UINT64 rows = 0;
+    if (!m_db._AtomicSendNoRetry(m_connection, sql.c_str())
+        || !m_db._AtomicAffectedRows(m_connection, rows) || rows != expectedAffectedRows)
+    { m_failed = true; return false; }
+    return true;
+}
+
+AtomicDbOutcome Database::TryAtomic(const std::function<bool(DatabaseAtomicTransaction&)>& operation)
+{
+    if (!operation) return AtomicDbOutcome::RolledBack;
+    // Admission makes the drained check + reservation a single ordering point
+    // relative to synchronous work and async enqueue. Never wait for the worker.
+    std::unique_lock<std::mutex> admission(m_admissionMutex);
+    if (IsQuarantined()) return AtomicDbOutcome::Quarantined;
+    std::unique_lock<std::mutex> connection(m_mutex, std::try_to_lock);
+    if (!connection.owns_lock()) return AtomicDbOutcome::Busy;
+    std::unique_lock<std::recursive_mutex> driver(m_driverMutex, std::try_to_lock);
+    if (!driver.owns_lock()) return AtomicDbOutcome::Busy;
+    {
+        std::scoped_lock queues(m_mutexBP, m_mutexAP);
+        if (m_pending.load() || m_inflight.load() || m_callbacks.load()
+            || !m_queueQueryBeforeProc.empty() || !m_queueQueryAfterProc.empty() || m_failures.load())
+            return AtomicDbOutcome::Busy;
+    }
+    DatabaseConnection* con = GetFreeConnection();
+    if (!con || !_AtomicCanStart(con)) return AtomicDbOutcome::Busy;
+    SynchronousDatabaseWork work(m_pending, m_inflight); // admission already held
+    admission.unlock();
+    bool beginAttempted = false;
+    try
+    {
+        if (!_AtomicConfigure(con)) return AtomicDbOutcome::RolledBack; // no BEGIN sent
+        beginAttempted = true; // The wire call or its error logger can throw.
+        if (!_AtomicSendNoRetry(con, "START TRANSACTION"))
+        { Quarantine(); return AtomicDbOutcome::Unknown; }
+        DatabaseAtomicTransaction transaction(*this, con);
+        bool success = false;
+        try { success = operation(transaction) && !transaction.HasFailed(); }
+        catch (...) { RecordFailure(); }
+        if (!success)
+        {
+            if (_AtomicSendNoRetry(con, "ROLLBACK")) return AtomicDbOutcome::RolledBack;
+            Quarantine(); return AtomicDbOutcome::Unknown;
+        }
+        if (_AtomicSendNoRetry(con, "COMMIT")) return AtomicDbOutcome::Committed;
+        // A failed COMMIT may already have committed remotely. Never replay.
+        Quarantine();
+        return AtomicDbOutcome::Unknown;
+    }
+    catch (...)
+    {
+        // Even allocation/logging failure after an uncertain wire result must
+        // quarantine BEFORE the connection/driver gates are released.
+        if (beginAttempted) { Quarantine(); return AtomicDbOutcome::Unknown; }
+        RecordFailure();
+        return AtomicDbOutcome::RolledBack;
+    }
+}
+
+void Database::RecordFailure()
+{
+	++m_failures;
+	++g_databaseFailures;
+}
