+DatabaseWorkStatus Database::GetWorkStatus()
+{
+	std::scoped_lock lock(m_mutexBP, m_mutexAP);
+	DatabaseWorkStatus status;
+	status.before = (UINT64)m_queueQueryBeforeProc.size();
+	status.inflight = m_inflight.load();
+	status.after = (UINT64)m_queueQueryAfterProc.size();
+	status.callbacks = m_callbacks.load();
+	status.pending = m_pending.load();
+	status.commits = m_commits.load();
+	status.failures = m_failures.load();
+	return status;
+}
+
+DatabaseWorkStatus Database::GetAllWorkStatus()
+{
+	DatabaseWorkStatus total;
+	for (Database* db : s_listDatabase)
+	{
+		DatabaseWorkStatus status = db->GetWorkStatus();
+		total.before += status.before;
+		total.inflight += status.inflight;
+		total.after += status.after;
+		total.callbacks += status.callbacks;
+		total.pending += status.pending;
+		total.commits += status.commits;
+		total.failures += status.failures;
+	}
+	total.pending = g_pendingDatabaseWork.load();
+	total.failures = g_databaseFailures.load();
+	return total;
+}
