+void CPlayerItemContainer::SortInventoryAtomic(const sUG_INVENTORY_SORT_ATOMIC_REQ& request)
+{
+    using namespace NtlInventorySort;
+    // Do not overwrite a previous operation's identity on a duplicate request.
+    if (IsInventoryMutationPending())
+    {
+        CNtlPacket packet(sizeof(sGU_INVENTORY_SORT_ATOMIC_RES));
+        auto* result = reinterpret_cast<sGU_INVENTORY_SORT_ATOMIC_RES*>(packet.GetPacketData());
+        memset(result, 0, sizeof(*result)); result->wOpCode = GU_INVENTORY_SORT_ATOMIC_RES;
+        result->token=request.token; result->byScope=request.byScope; result->byBankIndex=request.byBankIndex; result->byStatus=Busy;
+        packet.SetPacketLen(sizeof(*result)); m_pOwner->SendPacket(&packet); return;
+    }
+    m_sortClientToken=request.token; m_sortScope=request.byScope; m_sortBankIndex=request.byBankIndex;
+    if (!request.token || !((request.byScope == Bags && request.byBankIndex == 255)
+        || (request.byScope == PersonalBank && request.byBankIndex < 3)))
+    { SendInventorySortResult(Invalid); return; }
+    if (request.byScope == PersonalBank)
+    {
+        auto* npc = g_pObjectManager->GetNpc(request.hNpcHandle);
+        if (IsUsingGuildBank() || !m_pOwner->IsUsingBank() || !m_pOwner->IsBankLoaded() || !npc
+            || npc->GetWorldID() != m_pOwner->GetWorldID() || !npc->GetTbldat()
+            || npc->GetTbldat()->byJob != NPC_JOB_BANKER || !m_pOwner->IsInRange(npc, DBO_DISTANCE_CHECK_TOLERANCE))
+        { SendInventorySortResult(Invalid); return; }
+    }
+    const UINT64 token = BeginInventoryMutation(INVENTORY_MUTATION_SORT);
+    if (!token) { SendInventorySortResult(Busy); return; }
+    bool sent = false;
+    try
+    {
+        std::vector<Container> containers;
+        std::vector<Item> items;
+        std::vector<CItem*> parents;
+        if (request.byScope == Bags)
+        {
+            for (BYTE index=0; index<NTL_MAX_BAGSLOT_COUNT; ++index)
+            {
+                CItem* bag=m_arr_ActiveBags[index]; if (!bag) continue;
+                if (!bag->IsBag() || bag->GetOwner()!=m_pOwner || bag->GetPlace()!=CONTAINER_TYPE_BAGSLOT || bag->GetPos()!=index
+                    || bag->IsExpired() || bag->GetBagSize()==0 || bag->GetBagSize()>NTL_MAX_BAG_ITEM_SLOT)
+                    throw std::runtime_error("invalid sort parent");
+                containers.push_back({BYTE(CONTAINER_TYPE_BAG1+index),bag->GetBagSize(),true}); parents.push_back(bag);
+            }
+        }
+        else
+        {
+            CItem* parent=GetItem(CONTAINER_TYPE_BANKSLOT,request.byBankIndex);
+            if (!parent || parent->GetOwner()!=m_pOwner || parent->IsExpired()) throw std::runtime_error("missing bank parent");
+            containers.push_back({BYTE(CONTAINER_TYPE_BANK1+request.byBankIndex),NTL_MAX_BANK_ITEM_SLOT,true}); parents.push_back(parent);
+        }
+        const auto& selected=request.byScope==Bags?m_map_CharItems:m_map_BankItems;
+        for (const auto& pair:selected)
+        {
+            CItem* item=pair.second; if (!item) throw std::runtime_error("missing sort item");
+            const bool inScope=request.byScope==Bags ? item->GetPlace()>=CONTAINER_TYPE_BAG1 && item->GetPlace()<=CONTAINER_TYPE_BAG5
+                : item->GetPlace()==CONTAINER_TYPE_BANK1+request.byBankIndex;
+            if (!inScope) continue;
+            if (item->GetOwner()!=m_pOwner || !item->GetTbldat() || item->GetCount()>item->GetTbldat()->byMax_Stack)
+                throw std::runtime_error("invalid sort ownership");
+            items.push_back({item->GetItemID(),item->GetID(),item->GetTblidx(),item->GetCount(),item->GetTbldat()->byItem_Type,
+                item->GetRank(),item->GetGrade(),{item->GetPlace(),item->GetPos()},!item->IsLocked(false)&&!item->IsTrading()});
+        }
+        if (!BuildPlan(static_cast<Scope>(request.byScope),containers,items,m_sortMoves)) throw std::runtime_error("invalid sort plan");
+        // Allocate every tracking buffer BEFORE setting any lock/reservation.
+        m_sortLockedHandles.reserve(m_sortMoves.size()+parents.size());
+        m_sortReservedCells.reserve(MaxItems);
+        m_vecReservedInventory.reserve(m_vecReservedInventory.size()+MaxItems);
+        CNtlPacket packet(sizeof(sGQ_INVENTORY_SORT_ATOMIC_REQ));
+        auto* query=reinterpret_cast<sGQ_INVENTORY_SORT_ATOMIC_REQ*>(packet.GetPacketData());
+        memset(query,0,sizeof(*query));query->wOpCode=GQ_INVENTORY_SORT_ATOMIC_REQ;
+        query->token=token;query->handle=m_pOwner->GetID();query->charId=m_pOwner->GetCharID();query->accountId=m_pOwner->GetAccountID();
+        query->byScope=request.byScope;query->byBankIndex=request.byBankIndex;query->wCount=static_cast<WORD>(m_sortMoves.size());
+        if (!m_sortMoves.empty()) memcpy(query->moves,m_sortMoves.data(),sizeof(Move)*m_sortMoves.size());
+        for (CItem* parent:parents) { parent->SetLocked(true);m_sortLockedHandles.push_back(parent->GetID()); }
+        for (const auto& move:m_sortMoves)
+        {
+            CItem* item=GetItem(move.from.place,move.from.pos);
+            item->SetLocked(true);m_sortLockedHandles.push_back(item->GetID());
+        }
+        for (const auto& container:containers) for (BYTE pos=0;pos<container.capacity;++pos)
+        { AddReservedInventory(container.place,pos);m_sortReservedCells.push_back({container.place,pos}); }
+        packet.SetPacketLen(sizeof(*query));
+        auto* app=static_cast<CGameServer*>(g_pApp);
+        sent=true; // An exception/failed transport after submission is conservative UNKNOWN.
+        if (app->SendTo(app->GetQueryServerSession(),&packet)!=NTL_SUCCESS)
+        { MarkInventoryMutationUncertain(INVENTORY_MUTATION_SORT,token);SendInventorySortResult(PersistenceUnknown); }
+    }
+    catch (...)
+    {
+        if (sent) { MarkInventoryMutationUncertain(INVENTORY_MUTATION_SORT,token);SendInventorySortResult(PersistenceUnknown); }
+        else { EndInventoryMutation(INVENTORY_MUTATION_SORT,token);ReleaseInventorySort();SendInventorySortResult(Invalid); }
+    }
+}
+
+void CPlayerItemContainer::CompleteInventorySort(const sQG_INVENTORY_SORT_ATOMIC_RES& result)
+{
+    using namespace NtlInventorySort;
+    if (!MatchesInventoryMutation(INVENTORY_MUTATION_SORT,result.token)
+        || result.byScope!=m_sortScope || result.byBankIndex!=m_sortBankIndex
+        || result.handle!=m_pOwner->GetID() || result.charId!=m_pOwner->GetCharID()) return;
+    if (result.byStatus==PersistenceUnknown)
+    { MarkInventoryMutationUncertain(INVENTORY_MUTATION_SORT,result.token);SendInventorySortResult(PersistenceUnknown);return; }
+    if (result.byStatus==Ok)
+    {
+        bool valid=result.wCount==m_sortMoves.size() && result.wCount<=MaxItems
+            && (m_sortMoves.empty() || memcmp(result.moves,m_sortMoves.data(),sizeof(Move)*m_sortMoves.size())==0);
+        for (const auto& move:m_sortMoves)
+        {
+            CItem* item=GetItem(move.from.place,move.from.pos);
+            if (!item || item->GetID()!=move.handle || item->GetItemID()!=move.itemId || item->GetOwner()!=m_pOwner
+                || !item->IsLocked(false) || item->GetCount()!=move.count || item->GetTblidx()!=move.tableId
+                || item->GetRank()!=move.rank || item->GetGrade()!=move.grade) valid=false;
+        }
+        if (!valid)
+        { MarkInventoryMutationUncertain(INVENTORY_MUTATION_SORT,result.token);SendInventorySortResult(PersistenceUnknown);return; }
+        // Maps are keyed by handles, not cells; two byte fields per item change
+        // in one serialized callback, without allocation or synchronous events.
+        for (const auto& move:m_sortMoves)
+        { CItem* item=move.from.place<=CONTAINER_TYPE_BAG5?GetItem(move.handle):GetBankItem(move.handle);item->SetPlace(move.to.place);item->SetPos(move.to.pos); }
+    }
+    else if (result.byStatus!=Invalid && result.byStatus!=Busy && result.byStatus!=PersistenceFailed) return;
+    if (!EndInventoryMutation(INVENTORY_MUTATION_SORT,result.token)) return;
+    try { SendInventorySortResult(result.byStatus); }
+    catch (...)
+    {
+        // Persistence/Game state are known and reconciled. A local notification
+        // allocation failure must not strand server item locks after End.
+        printf("INVENTORY_SORT_CLIENT_NOTIFY_FAILED committed=%u client_reconnect_required=1\n", unsigned(result.byStatus==Ok));
+        fflush(stdout);
+    }
+    ReleaseInventorySort();
+}
+
+
+int CPlayerItemContainer::SendInventoryStackSortResult(BYTE status)
+{
+    using namespace NtlInventoryStackSort;
+    CNtlPacket packet(sizeof(sGU_INVENTORY_STACK_SORT_ATOMIC_RES));
+    auto* result = reinterpret_cast<sGU_INVENTORY_STACK_SORT_ATOMIC_RES*>(packet.GetPacketData());
+    memset(result, 0, sizeof(*result));
+    result->wOpCode = GU_INVENTORY_STACK_SORT_ATOMIC_RES;
+    result->token = m_stackSortClientToken;
+    result->byScope = m_stackSortScope; result->byBankIndex = m_stackSortBankIndex; result->byStatus = status;
+    if (status == Ok)
+    {
+        result->wCount = static_cast<WORD>(m_stackSortMoves.size());
+        for (size_t i = 0; i < m_stackSortMoves.size(); ++i)
+        {
+            const auto& move = m_stackSortMoves[i];
+            result->moves[i] = {move.handle, move.from, move.to, move.count, move.afterCount};
+        }
+    }
+    packet.SetPacketLen(sizeof(*result));
+    // Unlike CGameObject::SendPacket, retain the enqueue result. The admission
+    // gate and item locks remain set until this call has copied the reply into
+    // the connection's serialized send queue (or has returned an error).
+    auto* app = static_cast<CGameServer*>(g_pApp);
+    return app->Send(m_pOwner->GetClientSessionID(), &packet);
+}
+
+void CPlayerItemContainer::ReleaseInventoryStackSort()
+{
+    for (HOBJECT handle : m_stackSortLockedHandles)
+    {
+        CItem* item = GetItem(handle);
+        if (!item) item = GetBankItem(handle);
+        if (item) item->SetLocked(false);
+    }
+    for (const auto& cell : m_stackSortReservedCells) RemoveReservedInventory(cell.place, cell.pos);
+    m_stackSortMoves.clear(); m_stackSortSnapshot.clear();
+    m_stackSortLockedHandles.clear(); m_stackSortReservedCells.clear();
+}
+
+void CPlayerItemContainer::SortInventoryStackAtomic(const sUG_INVENTORY_STACK_SORT_ATOMIC_REQ& request)
+{
+    using namespace NtlInventoryStackSort;
+    if (IsInventoryMutationPending())
+    {
+        CNtlPacket packet(sizeof(sGU_INVENTORY_STACK_SORT_ATOMIC_RES));
+        auto* result = reinterpret_cast<sGU_INVENTORY_STACK_SORT_ATOMIC_RES*>(packet.GetPacketData());
+        memset(result, 0, sizeof(*result)); result->wOpCode = GU_INVENTORY_STACK_SORT_ATOMIC_RES;
+        result->token = request.token; result->byScope = request.byScope; result->byBankIndex = request.byBankIndex; result->byStatus = Busy;
+        packet.SetPacketLen(sizeof(*result)); m_pOwner->SendPacket(&packet); return;
+    }
+    m_stackSortClientToken = request.token; m_stackSortScope = request.byScope; m_stackSortBankIndex = request.byBankIndex;
+    if (!request.token || !((request.byScope == Bags && request.byBankIndex == 255)
+        || (request.byScope == PersonalBank && request.byBankIndex < 3)))
+    { SendInventoryStackSortResult(Invalid); return; }
+    if (request.byScope == PersonalBank)
+    {
+        auto* npc = g_pObjectManager->GetNpc(request.hNpcHandle);
+        if (IsUsingGuildBank() || !m_pOwner->IsUsingBank() || !m_pOwner->IsBankLoaded() || !npc
+            || npc->GetWorldID() != m_pOwner->GetWorldID() || !npc->GetTbldat()
+            || npc->GetTbldat()->byJob != NPC_JOB_BANKER || !m_pOwner->IsInRange(npc, DBO_DISTANCE_CHECK_TOLERANCE))
+        { SendInventoryStackSortResult(Invalid); return; }
+    }
+    const UINT64 token = BeginInventoryMutation(INVENTORY_MUTATION_STACK_SORT);
+    if (!token) { SendInventoryStackSortResult(Busy); return; }
+    bool submitted = false;
+    try
+    {
+        std::vector<Container> containers;
+        std::vector<Item> items;
+        std::vector<CItem*> parents;
+        if (request.byScope == Bags)
+        {
+            for (BYTE index = 0; index < NTL_MAX_BAGSLOT_COUNT; ++index)
+            {
+                CItem* bag = m_arr_ActiveBags[index]; if (!bag) continue;
+                if (!bag->IsBag() || bag->GetOwner() != m_pOwner || bag->GetPlace() != CONTAINER_TYPE_BAGSLOT || bag->GetPos() != index
+                    || bag->IsExpired() || bag->GetBagSize() == 0 || bag->GetBagSize() > NTL_MAX_BAG_ITEM_SLOT)
+                    throw std::runtime_error("invalid stack sort parent");
+                containers.push_back({BYTE(CONTAINER_TYPE_BAG1 + index), bag->GetBagSize(), true}); parents.push_back(bag);
+            }
+        }
+        else
+        {
+            CItem* parent = GetItem(CONTAINER_TYPE_BANKSLOT, request.byBankIndex);
+            if (!parent || parent->GetOwner() != m_pOwner || parent->IsExpired()) throw std::runtime_error("missing bank parent");
+            containers.push_back({BYTE(CONTAINER_TYPE_BANK1 + request.byBankIndex), NTL_MAX_BANK_ITEM_SLOT, true}); parents.push_back(parent);
+        }
+        const auto& selected = request.byScope == Bags ? m_map_CharItems : m_map_BankItems;
+        for (const auto& pair : selected)
+        {
+            CItem* item = pair.second; if (!item) throw std::runtime_error("missing stack sort item");
+            const bool inScope = request.byScope == Bags ? item->GetPlace() >= CONTAINER_TYPE_BAG1 && item->GetPlace() <= CONTAINER_TYPE_BAG5
+                : item->GetPlace() == CONTAINER_TYPE_BANK1 + request.byBankIndex;
+            if (!inScope) continue;
+            if (item->GetOwner() != m_pOwner || !item->GetTbldat() || item->GetCount() > item->GetTbldat()->byMax_Stack)
+                throw std::runtime_error("invalid stack sort ownership");
+            NtlInventorySort::Item value = {item->GetItemID(), item->GetID(), item->GetTblidx(), item->GetCount(), item->GetTbldat()->byItem_Type,
+                item->GetRank(), item->GetGrade(), {item->GetPlace(), item->GetPos()}, !item->IsLocked(false) && !item->IsTrading()};
+            items.push_back({value, item->GetTbldat()->byMax_Stack, item->GetItemData()});
+        }
+        if (!BuildPlan(static_cast<Scope>(request.byScope), containers, items, m_stackSortMoves)) throw std::runtime_error("invalid stack sort plan");
+        m_stackSortSnapshot.reserve(items.size());
+        for (const auto& item : items) m_stackSortSnapshot.push_back(item.metadata);
+        m_stackSortLockedHandles.reserve(m_stackSortMoves.size() + parents.size());
+        m_stackSortReservedCells.reserve(MaxItems);
+        m_vecReservedInventory.reserve(m_vecReservedInventory.size() + MaxItems);
+        CNtlPacket packet(sizeof(sGQ_INVENTORY_STACK_SORT_ATOMIC_REQ));
+        auto* query = reinterpret_cast<sGQ_INVENTORY_STACK_SORT_ATOMIC_REQ*>(packet.GetPacketData());
+        memset(query, 0, sizeof(*query)); query->wOpCode = GQ_INVENTORY_STACK_SORT_ATOMIC_REQ;
+        query->token = token; query->handle = m_pOwner->GetID(); query->charId = m_pOwner->GetCharID(); query->accountId = m_pOwner->GetAccountID();
+        query->byScope = request.byScope; query->byBankIndex = request.byBankIndex; query->wCount = static_cast<WORD>(m_stackSortMoves.size());
+        if (!m_stackSortMoves.empty()) memcpy(query->moves, m_stackSortMoves.data(), sizeof(Move) * m_stackSortMoves.size());
+        for (CItem* parent : parents) { parent->SetLocked(true); m_stackSortLockedHandles.push_back(parent->GetID()); }
+        for (const auto& move : m_stackSortMoves)
+        { CItem* item = GetItem(move.from.place, move.from.pos); item->SetLocked(true); m_stackSortLockedHandles.push_back(item->GetID()); }
+        for (const auto& container : containers) for (BYTE pos = 0; pos < container.capacity; ++pos)
+        { AddReservedInventory(container.place, pos); m_stackSortReservedCells.push_back({container.place, pos}); }
+        packet.SetPacketLen(sizeof(*query));
+        auto* app = static_cast<CGameServer*>(g_pApp);
+        submitted = true;
+        if (app->SendTo(app->GetQueryServerSession(), &packet) != NTL_SUCCESS)
+        { MarkInventoryMutationUncertain(INVENTORY_MUTATION_STACK_SORT, token); try { SendInventoryStackSortResult(PersistenceUnknown); } catch (...) {} }
+    }
+    catch (...)
+    {
+        if (submitted) { MarkInventoryMutationUncertain(INVENTORY_MUTATION_STACK_SORT, token); try { SendInventoryStackSortResult(PersistenceUnknown); } catch (...) {} }
+        else
+        {
+            // No persistence was submitted. Queue the known rejection before
+            // admission reopens, then release even if the client has gone away.
+            try { SendInventoryStackSortResult(Invalid); } catch (...) {}
+            EndInventoryMutation(INVENTORY_MUTATION_STACK_SORT, token); ReleaseInventoryStackSort();
+        }
+    }
+}
+
+void CPlayerItemContainer::CompleteInventoryStackSort(const sQG_INVENTORY_STACK_SORT_ATOMIC_RES& result)
+{
+    using namespace NtlInventoryStackSort;
+    if (!MatchesInventoryMutation(INVENTORY_MUTATION_STACK_SORT, result.token)
+        || result.byScope != m_stackSortScope || result.byBankIndex != m_stackSortBankIndex
+        || result.handle != m_pOwner->GetID() || result.charId != m_pOwner->GetCharID()) return;
+    if (result.byStatus == PersistenceUnknown)
+    { MarkInventoryMutationUncertain(INVENTORY_MUTATION_STACK_SORT, result.token); try { SendInventoryStackSortResult(PersistenceUnknown); } catch (...) {} return; }
+    if (result.byStatus != Ok && result.byStatus != Invalid && result.byStatus != Busy && result.byStatus != PersistenceFailed) return;
+    if (result.byStatus != Ok && result.wCount != 0) return;
+    if (result.byStatus == Ok)
+    {
+        bool valid = result.wCount == m_stackSortMoves.size() && result.wCount <= MaxItems
+            && (m_stackSortMoves.empty() || memcmp(result.moves, m_stackSortMoves.data(), sizeof(Move) * m_stackSortMoves.size()) == 0);
+        for (const auto& before : m_stackSortSnapshot)
+        {
+            CItem* item = GetItem(before.byPlace, before.byPosition);
+            const auto move = std::find_if(m_stackSortMoves.begin(), m_stackSortMoves.end(), [&before](const Move& value) { return value.itemId == before.itemId; });
+            if (!item || item->GetItemID() != before.itemId || item->GetOwner() != m_pOwner || !item->IsLocked(false)
+                || move == m_stackSortMoves.end() || item->GetID() != move->handle || !item->GetTbldat()
+                || item->GetTbldat()->byMax_Stack != move->maxStack
+                || item->GetCount() != before.byStackcount || !SameStackMetadata(item->GetItemData(), before)) valid = false;
+        }
+        if (!valid)
+        { MarkInventoryMutationUncertain(INVENTORY_MUTATION_STACK_SORT, result.token); try { SendInventoryStackSortResult(PersistenceUnknown); } catch (...) {} return; }
+        try
+        {
+            for (const auto& move : m_stackSortMoves)
+            {
+                CItem* item = move.from.place <= CONTAINER_TYPE_BAG5 ? GetItem(move.handle) : GetBankItem(move.handle);
+                if (move.afterCount)
+                { item->SetPlace(move.to.place); item->SetPos(move.to.pos); item->GetItemData().byStackcount = move.afterCount; }
+                else
+                {
+                    // No legacy SetCount/GU_ITEM_DELETE and no second SQL write.
+                    // Remove the duration reference as well as the owning map.
+                    RemoveItem(move.from.place, move.handle); item->SetOwner(NULL);
+                    g_pItemManager->DestroyItem(item);
+                }
+            }
+        }
+        catch (...)
+        {
+            // DB already committed. Never save a partially reconciled Game
+            // inventory or release the barrier after a local destruction failure.
+            MarkInventoryMutationUncertain(INVENTORY_MUTATION_STACK_SORT, result.token);
+            try { SendInventoryStackSortResult(PersistenceUnknown); } catch (...) {}
+            return;
+        }
+    }
+    try { SendInventoryStackSortResult(result.byStatus); }
+    catch (...) { /* Known server state; reconnect reloads it if notification failed. */ }
+    if (!EndInventoryMutation(INVENTORY_MUTATION_STACK_SORT, result.token)) return;
+    ReleaseInventoryStackSort();
+}
