+sWORLD_MAP_TBLDAT* CWorldMapGui::GetNpcSelectorMap(TBLIDX id, DWORD level)
+{
+    sWORLD_MAP_TBLDAT* row = reinterpret_cast<sWORLD_MAP_TBLDAT*>(API_GetTableContainer()->GetWorldMapTable()->FindData(id));
+    if (!row || !row->bValidityAble || row->dwComboBoxType < 1 || row->dwComboBoxType > 3 ||
+        (level && row->dwComboBoxType != level) ||
+        (row->byMapType != WORLDMAP_TYPE_WORLD && row->byMapType != WORLDMAP_TYPE_ZONE &&
+         row->byMapType != WORLDMAP_TYPE_ZONE2 && row->byMapType != WORLDMAP_TYPE_CITY) ||
+        (row->dwComboBoxType == 1 && row->byMapType != WORLDMAP_TYPE_WORLD) ||
+        (row->dwComboBoxType == 2 && row->byMapType != WORLDMAP_TYPE_ZONE && row->byMapType != WORLDMAP_TYPE_ZONE2) ||
+        (row->dwComboBoxType == 3 && row->byMapType != WORLDMAP_TYPE_CITY && row->byMapType != WORLDMAP_TYPE_ZONE2) ||
+        !_finite(row->vStandardLoc.x) || !_finite(row->vStandardLoc.z) || !_finite(row->fWorldmapScale) || row->fWorldmapScale <= 0.f ||
+        !API_GetTableContainer()->GetWorldTable()->FindData(row->World_Tblidx) ||
+        GetWorldMapTable(row->World_Tblidx, row->Zone_Tblidx) != row) return NULL;
+    return row;
+}
