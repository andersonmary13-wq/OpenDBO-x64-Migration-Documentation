diff --git a/NtlLib/Server/NtlSystem/NtlRotatingLog.h b/NtlLib/Server/NtlSystem/NtlRotatingLog.h
new file mode 100644
--- /dev/null
+++ b/NtlLib/Server/NtlSystem/NtlRotatingLog.h
@@ -0,0 +1,48 @@
+#pragma once
+#include <windows.h>
+#include <stdio.h>
+#include <io.h>
+#include <tchar.h>
+#include <mutex>
+#include <string>
+
+// Keep the FILE object owned by CNtlFileStream valid. Never truncate a log
+// unless its flushed contents were successfully copied to the first backup.
+inline bool NtlWriteRotatingLog(FILE* stream, const TCHAR* line, __int64 limit = 10 * 1024 * 1024)
+{
+    static std::mutex mutex;
+    std::lock_guard<std::mutex> guard(mutex);
+    const int fd = _fileno(stream);
+    bool rotated = true;
+    if (_filelengthi64(fd) >= limit)
+    {
+        rotated = fflush(stream) == 0;
+        wchar_t path[32768];
+        const DWORD length = GetFinalPathNameByHandleW((HANDLE)_get_osfhandle(fd), path, _countof(path), FILE_NAME_NORMALIZED);
+        rotated = rotated && length > 0 && length < _countof(path);
+        if (rotated)
+        {
+            const std::wstring name(path, length);
+            for (int n = 1; n <= 3 && rotated; ++n)
+            {
+                const DWORD attributes = GetFileAttributesW((name + L"." + std::to_wstring(n)).c_str());
+                if (attributes != INVALID_FILE_ATTRIBUTES &&
+                    (attributes & (FILE_ATTRIBUTE_DIRECTORY | FILE_ATTRIBUTE_REPARSE_POINT))) rotated = false;
+            }
+            // Missing older generations are normal. Other rename errors abort
+            // the rotation before touching the current file.
+            for (int n = 2; n >= 1 && rotated; --n)
+            {
+                const std::wstring from = name + L"." + std::to_wstring(n);
+                const std::wstring to = name + L"." + std::to_wstring(n + 1);
+                if (!MoveFileExW(from.c_str(), to.c_str(), MOVEFILE_REPLACE_EXISTING))
+                    rotated = GetLastError() == ERROR_FILE_NOT_FOUND;
+            }
+            if (rotated) rotated = CopyFileW(name.c_str(), (name + L".1").c_str(), FALSE) != FALSE;
+            if (rotated) rotated = _chsize_s(fd, 0) == 0;
+            if (rotated) rotated = _fseeki64(stream, 0, SEEK_SET) == 0;
+        }
+    }
+    const bool written = _ftprintf(stream, TEXT("%s\n"), line) >= 0 && fflush(stream) == 0;
+    return rotated && written;
+}
