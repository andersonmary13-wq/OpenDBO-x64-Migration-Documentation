+
+// Upgrade coupons have a separate request; they are not ordinary UseItem effects.
+RwBool CItemUpgradeGui::IsUpgradeCoupon(CNtlSobItemAttr* attr) const
+{
+    return attr && attr->GetItemTbl() && NtlIsUpgradeCouponType(attr->GetItemTbl()->byItem_Type);
+}
+
+RwBool CItemUpgradeGui::IsCouponMode() const
+{
+    return m_pStoneItem && IsUpgradeCoupon(reinterpret_cast<CNtlSobItemAttr*>(m_pStoneItem->GetSobAttr()));
+}
+
+RwBool CItemUpgradeGui::IsValidCouponPair(CNtlSobItemAttr* equip, CNtlSobItemAttr* coupon, bool feedback)
+{
+    if (!IsUpgradeCoupon(coupon) || (equip && !equip->GetItemTbl())) return FALSE;
+    sITEM_TBLDAT* c = coupon->GetItemTbl();
+    if (!c->bValidity_Able || coupon->IsNeedToIdentify() || coupon->IsExpired())
+    {
+        if (feedback) { WCHAR text[] = L"This coupon is invalid, unidentified or expired."; GetAlarmManager()->AlarmMessage(text); }
+        return FALSE;
+    }
+    unsigned int group = equip ? GetItemTypeGroup(equip->GetItemTbl()->byItem_Type) :
+        (c->byItem_Type == ITEM_TYPE_UPGRADE_COUPON_ARMOR ? ITEM_TYPE_GROUP_ARMOR : ITEM_TYPE_GROUP_WEAPON);
+    WORD result = NtlCheckUpgradeCoupon(c->byItem_Type, c->Charm_Tblidx, c->contentsTblidx,
+        c->byNeed_Min_Level, c->byNeed_Max_Level, coupon->GetStackNum(), c->byMax_Stack,
+        group, equip ? equip->GetItemTbl()->byNeed_Min_Level : c->byNeed_Min_Level,
+        equip ? equip->GetGrade() : 0, equip ? equip->IsNeedToIdentify() != FALSE : false,
+        equip ? equip->GetItemTbl()->byRestrictType : ITEM_RESTRICT_TYPE_NONE,
+        equip ? equip->GetRestrictState() : ITEM_RESTRICT_STATE_TYPE_NONE,
+        equip ? equip->GetDurationType() : eDURATIONTYPE_NORMAL, equip ? equip->GetStackNum() : 1);
+    if (result != GAME_SUCCESS && feedback)
+        GetAlarmManager()->AlarmMessage(Logic_GetResultCodeString(result, "GU_ITEM_UPGRADE_BY_COUPON_RES"), TRUE);
+    return result == GAME_SUCCESS;
+}
+
+VOID CItemUpgradeGui::SetCouponInfo()
+{
+    if (!IsCouponMode()) return;
+    sITEM_TBLDAT* coupon = reinterpret_cast<CNtlSobItemAttr*>(m_pStoneItem->GetSobAttr())->GetItemTbl();
+    WCHAR text[512];
+    swprintf_s(text, L"Coupon: guaranteed +%u for %u seconds.[br]Equipment level: %u - %u. Only +0, identified, non-bound, permanent equipment.[br]Apply consumes one coupon and temporarily binds the equipment. It returns to +0 when the effect expires.[br]No guard stone, upgrade fee or card roll.",
+        coupon->Charm_Tblidx, coupon->contentsTblidx, coupon->byNeed_Min_Level, coupon->byNeed_Max_Level);
+    m_phtmlInfoText->SetHtmlFromMemory(text, wcslen(text));
+    m_pbtnSelect->SetText(L"Apply Coupon");
+}
+
+VOID CItemUpgradeGui::OnCouponResult(WORD result)
+{
+    if (!m_bCouponWaiting) return;
+    m_bCouponWaiting = FALSE;
+    m_bCouponTimeoutNotified = FALSE;
+    // Authoritative item/stack packets update the inventory separately.
+    DeleteHoipoiStone();
+    DeleteUpgradeItem();
+    SetState(STATE_NONE);
+    if (result == GAME_SUCCESS)
+    {
+        WCHAR text[] = L"Coupon applied successfully. Check the equipment for its expiry time.";
+        GetAlarmManager()->AlarmMessage(text);
+    }
+}
