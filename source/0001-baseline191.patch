diff --git a/DboShared/NtlShared2/NtlUpgradeCoupon.h b/DboShared/NtlShared2/NtlUpgradeCoupon.h
new file mode 100644
--- /dev/null
+++ b/DboShared/NtlShared2/NtlUpgradeCoupon.h
@@ -0,0 +1,44 @@
+#pragma once
+
+#include "NtlItem.h"
+#include "NtlResultCode.h"
+
+// Shared feedback/authority rules. Values come from the item tables, never from
+// a client-supplied grade or duration. This does not perform an item mutation.
+inline bool NtlIsUpgradeCouponType(unsigned int type)
+{
+    return type == ITEM_TYPE_UPGRADE_COUPON_WEAPON ||
+           type == ITEM_TYPE_UPGRADE_COUPON_ARMOR ||
+           type == ITEM_TYPE_UPGRADE_COUPON_FULL;
+}
+
+inline WORD NtlCheckUpgradeCoupon(unsigned int couponType, unsigned int couponGrade,
+    unsigned int duration, unsigned int minimumLevel, unsigned int maximumLevel,
+    unsigned int stack, unsigned int maximumStack, unsigned int equipmentGroup,
+    unsigned int equipmentLevel, unsigned int equipmentGrade, bool unidentified,
+    unsigned int restrictType, unsigned int restrictState, unsigned int durationType,
+    unsigned int equipmentStack = 1)
+{
+    if (!NtlIsUpgradeCouponType(couponType) || couponGrade == 0 ||
+        couponGrade > NTL_ITEM_MAX_GRADE || duration == 0 || duration == 0xffffffff ||
+        minimumLevel > maximumLevel)
+        return GAME_ITEM_UPGRADE_COUPON_NOT_FOUND;
+    if (maximumStack == 0 || stack == 0 || stack > maximumStack || equipmentStack != 1)
+        return GAME_ITEM_STACK_FAIL;
+    if (equipmentGroup != ITEM_TYPE_GROUP_WEAPON && equipmentGroup != ITEM_TYPE_GROUP_ARMOR)
+        return GAME_ITEM_UPGRADE_WRONG_ITEM_TYPE;
+    if (equipmentGroup == ITEM_TYPE_GROUP_WEAPON &&
+        couponType != ITEM_TYPE_UPGRADE_COUPON_WEAPON && couponType != ITEM_TYPE_UPGRADE_COUPON_FULL)
+        return GAME_ITEM_UPGRADE_MUST_USE_STONE_WEAPON;
+    if (equipmentGroup == ITEM_TYPE_GROUP_ARMOR &&
+        couponType != ITEM_TYPE_UPGRADE_COUPON_ARMOR && couponType != ITEM_TYPE_UPGRADE_COUPON_FULL)
+        return GAME_ITEM_UPGRADE_MUST_USE_STONE_ARMOR;
+    if (equipmentGrade != 0)
+        return GAME_ITEM_UPGRADE_COUPON_GRADE_FAIL;
+    if (unidentified || restrictType != ITEM_RESTRICT_TYPE_NONE ||
+        restrictState != ITEM_RESTRICT_STATE_TYPE_NONE || durationType != eDURATIONTYPE_NORMAL)
+        return GAME_ITEM_UPGRADE_FAIL_FOR_DURATION_ITEM;
+    if (equipmentLevel < minimumLevel || equipmentLevel > maximumLevel)
+        return GAME_ITEM_NOT_INSERT_BEAD_INVALID_LEVEL;
+    return GAME_SUCCESS;
+}
