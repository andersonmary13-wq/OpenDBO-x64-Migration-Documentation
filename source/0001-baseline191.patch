+VOID CWorldMapGui::ApplyNpcSearchPulse()
+{
+	// Reuse the borrowed marker: no texture, renderer or allocation work per update.
+	static const unsigned int alpha[5] = { 255, 160, 64, 64, 160 };
+	if (m_pRegionName)
+		m_surSearchNpc.SetAlpha(static_cast<RwUInt8>(GetAlpha() * alpha[m_byNpcSearchPulseStep] / 255));
+}
+
+VOID CWorldMapGui::UpdateNpcSearchPulse(RwReal fElapsed)
+{
+	if (!IsShow() || m_uiSelectedSearchNpc == INVALID_TBLIDX) return;
+	if (!_finite(fElapsed) || fElapsed <= 0.f) return;
+	m_fNpcSearchPulseElapsed = static_cast<RwReal>(std::fmod(m_fNpcSearchPulseElapsed + std::fmod(fElapsed, 1.f), 1.f));
+	RwUInt8 step = static_cast<RwUInt8>(m_fNpcSearchPulseElapsed * 5.f);
+	if (step != m_byNpcSearchPulseStep)
+	{
+		m_byNpcSearchPulseStep = step;
+		ApplyNpcSearchPulse();
+	}
+}
