diff --git a/DboServer/Server/QueryServer/ItemOptionValue.h b/DboServer/Server/QueryServer/ItemOptionValue.h
new file mode 100644
--- /dev/null
+++ b/DboServer/Server/QueryServer/ItemOptionValue.h
@@ -0,0 +1,21 @@
+#pragma once
+
+#include "Field.h"
+#include <limits>
+
+// Item option columns store unsigned32bits; the native optionValue is signed32.
+// Decode the bit pattern without Windows atol saturation or an out-of-range
+// unsigned-to-signed cast. Generic Field::GetINT and all other columns stay unchanged.
+namespace QueryItemDecode
+{
+    inline int RandomOptionValue(Field& field)
+    {
+        static_assert(sizeof(int) == 4 && sizeof(unsigned int) == 4, "item option32bit scalar contract");
+        static_assert((std::numeric_limits<int>::max)() == 2147483647
+            && (std::numeric_limits<int>::min)() == (-2147483647 - 1), "native signed32range");
+        const unsigned int bits = field.GetUInt32();
+        if (bits <= static_cast<unsigned int>((std::numeric_limits<int>::max)()))
+            return static_cast<int>(bits);
+        return -1 - static_cast<int>((std::numeric_limits<unsigned int>::max)() - bits);
+    }
+}
