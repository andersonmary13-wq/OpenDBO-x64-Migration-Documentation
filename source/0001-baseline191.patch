+bool CDboApplication::ShouldDeferWindowChange(void)
+{
+	const HWND hWnd = GetHWnd();
+	return g_clWorkThreadMgr.GetThreadCnt() > 0 || hWnd == NULL ||
+		::IsIconic(hWnd) || ::GetForegroundWindow() != ::GetAncestor(hWnd, GA_ROOT);
+}
+
+RwBool CDboApplication::ToggleFullMode(void)
+{
+	// Keyboard toggles use the queued target, so two presses cancel while loading.
+	const RwBool target = !(m_bPendingFullMode ? m_bPendingFullScreen : IsFullScreen());
+	return SetFullMode(target);
+}
+
+RwBool CDboApplication::SetFullMode(RwBool bFullScreen)
+{
+	if (ShouldDeferWindowChange())
+	{
+		m_bPendingFullMode = TRUE;
+		m_bPendingFullScreen = bFullScreen;
+		return TRUE;
+	}
+
+	m_bPendingFullMode = FALSE;
+	if (IsFullScreen() == bFullScreen)
+		return TRUE;
+	return CNtlApplication::ToggleFullMode();
+}
+
+void CDboApplication::ChangeVideoMode(RwInt32 iWidth, RwInt32 iHeight, RwInt32 iBitDepth)
+{
+	if (ShouldDeferWindowChange())
+	{
+		m_bPendingVideoMode = TRUE;
+		m_iPendingVideoWidth = iWidth;
+		m_iPendingVideoHeight = iHeight;
+		m_iPendingVideoDepth = iBitDepth;
+		return;
+	}
+
+	m_bPendingVideoMode = FALSE;
+	if (iWidth == GetUserWidth() && iHeight == GetUserHeight() && iBitDepth == GetBitDepth())
+		return;
+	CNtlApplication::ChangeVideoMode(iWidth, iHeight, iBitDepth);
+}
+
+void CDboApplication::ApplyPendingWindowChange(void)
+{
+	if (ShouldDeferWindowChange())
+		return;
+
+	// SetWindowPos may synchronously call Resize and consume these flags.
+	const RwBool resize = m_bPendingResize;
+	const RwBool restore = m_bPendingResizeRestore;
+	if (m_bPendingFullMode)
+	{
+		const RwBool target = m_bPendingFullScreen;
+		m_bPendingFullMode = FALSE;
+		SetFullMode(target);
+	}
+
+	if (m_bPendingVideoMode && !ShouldDeferWindowChange())
+	{
+		const RwInt32 width = m_iPendingVideoWidth;
+		const RwInt32 height = m_iPendingVideoHeight;
+		const RwInt32 depth = m_iPendingVideoDepth;
+		m_bPendingVideoMode = FALSE;
+		ChangeVideoMode(width, height, depth);
+	}
+
+	m_bPendingResize = m_bPendingResize || resize || restore;
+	m_bPendingResizeRestore = m_bPendingResizeRestore || restore;
+	if (ShouldDeferWindowChange() || !m_bPendingResize)
+		return;
+
+	RECT rect = {0, 0, 0, 0};
+	if (!::GetClientRect(GetHWnd(), &rect) || rect.right <= rect.left || rect.bottom <= rect.top)
+		return;
+	Resize(rect.right - rect.left, rect.bottom - rect.top, TRUE, m_bPendingResizeRestore);
+}
