+
+bool Database::WaitForAllWorkDrained(UINT32 timeoutMs)
+{
+	const auto deadline = std::chrono::steady_clock::now() + std::chrono::milliseconds(timeoutMs);
+	for (;;)
+	{
+		DatabaseWorkStatus status = GetAllWorkStatus();
+		if (status.failures != 0) return false;
+		if (status.IsDrained()) return true;
+		if (std::chrono::steady_clock::now() >= deadline) return false;
+		std::this_thread::sleep_for(std::chrono::milliseconds(1));
+	}
+}
+
+bool Database::DrainAndStop(UINT32 timeoutMs)
+{
+	const auto deadline = std::chrono::steady_clock::now() + std::chrono::milliseconds(timeoutMs);
+	for (;;)
+	{
