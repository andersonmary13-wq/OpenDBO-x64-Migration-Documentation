+// Called only with Database's driver gate held for the entire transaction.
+bool MySQLDatabase::_AtomicCanStart(DatabaseConnection* con)
+{
+    const auto* db = static_cast<MySQLDatabaseConnection*>(con);
+    return !IsQuarantined() && db && db->MySql
+        && !(db->MySql->server_status & SERVER_STATUS_IN_TRANS);
+}
+
+bool MySQLDatabase::_AtomicConfigure(DatabaseConnection* con)
+{
+    // mysql_query itself must not silently reconnect and lose the transaction.
+    // Keep implicit reconnect off afterwards; legacy explicit retry is unchanged.
+    my_bool reconnect = false;
+    if (mysql_options(static_cast<MySQLDatabaseConnection*>(con)->MySql,
+        MYSQL_OPT_RECONNECT, &reconnect) == 0) return true;
+    RecordFailure();
+    return false;
+}
+
+bool MySQLDatabase::_AtomicSendNoRetry(DatabaseConnection* con, const char* sql)
+{
+    if (IsQuarantined()) return false;
+    MYSQL* mysql = static_cast<MySQLDatabaseConnection*>(con)->MySql;
+    if (mysql_query(mysql, sql) != 0)
+    {
+        RecordFailure();
+        ERR_LOG(LOG_SYSTEM, "ATOMIC_SQL_FAILED code=%u", mysql_errno(mysql));
+        return false;
+    }
+    if (_stricmp(sql, "COMMIT") == 0) ++m_commits;
+    return true;
+}
+
+bool MySQLDatabase::_AtomicStoreResult(DatabaseConnection* con, QueryResult*& result)
+{
+    result = nullptr;
+    MYSQL* mysql = static_cast<MySQLDatabaseConnection*>(con)->MySql;
+    MYSQL_RES* rows = mysql_store_result(mysql);
+    if (!rows) { RecordFailure(); return false; }
+    const auto count = mysql_num_rows(rows);
+    const auto fields = mysql_num_fields(rows);
+    if (count == 0) { mysql_free_result(rows); return true; }
+    if (fields == 0 || count > UINT32_MAX) { mysql_free_result(rows); RecordFailure(); return false; }
+    MySQLQueryResult* owned = nullptr;
+    try { owned = new MySQLQueryResult(rows, fields, static_cast<UINT32>(count)); }
+    catch (...) { mysql_free_result(rows); throw; }
+    try
+    {
+        if (!owned->NextRow()) { delete owned; RecordFailure(); return false; }
+    }
+    catch (...) { delete owned; throw; }
+    result = owned;
+    return true;
+}
+
+bool MySQLDatabase::_AtomicAffectedRows(DatabaseConnection* con, UINT64& rows)
+{
+    const my_ulonglong count = mysql_affected_rows(static_cast<MySQLDatabaseConnection*>(con)->MySql);
+    if (count == static_cast<my_ulonglong>(-1)) { RecordFailure(); return false; }
+    rows = static_cast<UINT64>(count);
+    return true;
+}
