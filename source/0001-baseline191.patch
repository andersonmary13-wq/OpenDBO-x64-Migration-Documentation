+void CGameServerSession::RecvInventorySortAtomicReq(CNtlPacket* packet, CQueryServer* app)
+{
+    using namespace NtlInventorySort;
+    if (packet->GetPacketDataSize() != sizeof(sGQ_INVENTORY_SORT_ATOMIC_REQ)) return;
+    const auto* request = reinterpret_cast<const sGQ_INVENTORY_SORT_ATOMIC_REQ*>(packet->GetPacketData());
+    CNtlPacket response(sizeof(sQG_INVENTORY_SORT_ATOMIC_RES));
+    auto* result = reinterpret_cast<sQG_INVENTORY_SORT_ATOMIC_RES*>(response.GetPacketData());
+    memset(result, 0, sizeof(*result));
+    result->wOpCode = QG_INVENTORY_SORT_ATOMIC_RES;
+    result->token = request->token; result->handle = request->handle; result->charId = request->charId;
+    result->byScope = request->byScope; result->byBankIndex = request->byBankIndex; result->byStatus = Invalid;
+    const auto execute = [&]() -> bool
+    {
+        if (!request->token || request->wCount > MaxItems) return false;
+        CPlayerCache* cache = g_pPlayerCache->GetCharacter(request->charId);
+        if (!cache || cache->GetAccountID() != request->accountId || cache->GetSession() != GetHandle()) return false;
+        std::vector<sITEM_DATA*> cached;
+        if (!cache->CollectInventorySortItems(request->byScope, request->byBankIndex, cached) || cached.size() != request->wCount) return false;
+        std::vector<sITEM_DATA> snapshot;
+        for (const auto* item : cached) snapshot.push_back(*item);
+        std::vector<Move> moves(request->moves, request->moves + request->wCount);
+        const auto outcome = g_pItemRepository->ApplyInventorySortAtomic(request->charId, request->byScope, request->byBankIndex, snapshot, moves);
+        if (outcome == AtomicDbOutcome::Unknown || outcome == AtomicDbOutcome::Quarantined)
+        { result->byStatus = PersistenceUnknown; return false; }
+        if (outcome == AtomicDbOutcome::Busy) { result->byStatus = Busy; return false; }
+        if (outcome != AtomicDbOutcome::Committed) { result->byStatus = PersistenceFailed; return false; }
+        // All lookups/allocations finish before COMMIT. Updating two byte fields
+        // afterwards cannot enqueue SQL or allocate and must not precede COMMIT.
+        for (auto* item : cached)
+        {
+            for (const auto& move : moves) if (move.itemId == item->itemId)
+            { item->byPlace = move.to.place; item->byPosition = move.to.pos; break; }
+        }
+        result->byStatus = Ok;
+        result->wCount = request->wCount;
+        memcpy(result->moves, request->moves, sizeof(Move) * request->wCount);
+        return true;
+    };
+    execute();
+    response.SetPacketLen(sizeof(*result));
+    app->Send(GetHandle(), &response);
+}
+
+
+void CGameServerSession::RecvInventoryStackSortAtomicReq(CNtlPacket* packet, CQueryServer* app)
+{
+    using namespace NtlInventoryStackSort;
+    if (!packet || packet->GetPacketDataSize() != sizeof(sGQ_INVENTORY_STACK_SORT_ATOMIC_REQ)) return;
+    const auto* request = reinterpret_cast<const sGQ_INVENTORY_STACK_SORT_ATOMIC_REQ*>(packet->GetPacketData());
+    CNtlPacket response(sizeof(sQG_INVENTORY_STACK_SORT_ATOMIC_RES));
+    auto* result = reinterpret_cast<sQG_INVENTORY_STACK_SORT_ATOMIC_RES*>(response.GetPacketData());
+    memset(result, 0, sizeof(*result));
+    result->wOpCode = QG_INVENTORY_STACK_SORT_ATOMIC_RES;
+    result->token = request->token; result->handle = request->handle; result->charId = request->charId;
+    result->byScope = request->byScope; result->byBankIndex = request->byBankIndex; result->byStatus = Invalid;
+    bool committed = false;
+    try
+    {
+        const auto execute = [&]() -> bool
+        {
+            if (!request->token || request->wCount > MaxItems) return false;
+            CPlayerCache* cache = g_pPlayerCache->GetCharacter(request->charId);
+            if (!cache || cache->GetAccountID() != request->accountId || cache->GetSession() != GetHandle()) return false;
+            std::vector<sITEM_DATA*> cached;
+            if (!cache->CollectInventorySortItems(request->byScope, request->byBankIndex, cached)
+                || cached.size() != request->wCount) return false;
+            std::vector<sITEM_DATA> snapshot;
+            snapshot.reserve(cached.size());
+            for (const auto* item : cached) snapshot.push_back(*item);
+            std::vector<Move> moves(request->moves, request->moves + request->wCount);
+            // Resolve all cache links before asking the database to commit.
+            std::vector<std::pair<sITEM_DATA*, const Move*>> apply;
+            apply.reserve(cached.size());
+            if (!ValidatePlan(static_cast<Scope>(request->byScope), request->byBankIndex, snapshot, moves)) return false;
+            for (auto* item : cached)
+            {
+                const auto it = std::find_if(moves.begin(), moves.end(), [item](const Move& move) { return move.itemId == item->itemId; });
+                if (it == moves.end()) return false;
+                apply.emplace_back(item, &*it);
+            }
+            const auto outcome = g_pItemRepository->ApplyInventoryStackSortAtomic(request->charId, request->byScope, request->byBankIndex, snapshot, moves);
+            if (outcome == AtomicDbOutcome::Unknown || outcome == AtomicDbOutcome::Quarantined)
+            { result->byStatus = PersistenceUnknown; return false; }
+            if (outcome == AtomicDbOutcome::Busy) { result->byStatus = Busy; return false; }
+            if (outcome != AtomicDbOutcome::Committed) { result->byStatus = PersistenceFailed; return false; }
+            committed = true;
+            for (const auto& entry : apply)
+            {
+                const Move& move = *entry.second;
+                if (move.afterCount)
+                { entry.first->byPlace = move.to.place; entry.first->byPosition = move.to.pos; entry.first->byStackcount = move.afterCount; }
+                else if (request->byScope == PersonalBank)
+                {
+                    sITEM_DATA* bankItem = cache->GetBankItem(move.itemId, move.from.place, move.from.pos);
+                    if (bankItem != entry.first)
+                    { GetCharDB.QuarantineAfterReconciliationFailure(); result->byStatus = PersistenceUnknown; return false; }
+                    cache->EraseBankItem(move.itemId);
+                    delete bankItem;
+                }
+                else if (!cache->RemoveItem(move.itemId))
+                { GetCharDB.QuarantineAfterReconciliationFailure(); result->byStatus = PersistenceUnknown; return false; }
+            }
+            result->byStatus = Ok; result->wCount = request->wCount;
+            if (request->wCount) memcpy(result->moves, request->moves, sizeof(Move) * request->wCount);
+            return true;
+        };
+        execute();
+    }
+    catch (...)
+    {
+        // An unknown database outcome is handled/quarantined by TryAtomic.
+        // A local postcommit cache failure must never be reported as rollback.
+        result->byStatus = committed ? PersistenceUnknown : PersistenceFailed;
+        if (committed) GetCharDB.QuarantineAfterReconciliationFailure();
+        result->wCount = 0;
+    }
+    response.SetPacketLen(sizeof(*result));
+    app->Send(GetHandle(), &response);
+}
