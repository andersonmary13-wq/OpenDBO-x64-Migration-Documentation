+
+void CGameProcessor::UpdateShutdown()
+{
+	if (!m_shutdownDisconnected.load()) return;
+	m_shutdownPlayers.store((UINT64)g_pObjectManager->GetPlayerCount());
+	if (m_shutdownPlayers.load() != 0 || m_shutdownBarrierSent) return;
+	std::lock_guard<std::mutex> dispatchLock(m_shutdownDispatchMutex);
+	if (!m_shutdownQuiesced.exchange(true))
+	{
+		printf("SHUTDOWN_GAME_QUIESCED players=0 gameplay_handlers_blocked=1\n");
+		fflush(stdout);
+	}
+	CGameServer* app = (CGameServer*)g_pApp;
+	CQueryServerSession* query = app->GetQueryServerSession();
+	if (!query || !query->IsConnected()) return; // Timeout remains fail-closed if Query is unavailable.
+	const UINT64 token = (GetTickCount64() << 16) ^ (UINT64)GetCurrentProcessId();
+	m_shutdownToken.store(token);
+	CNtlPacket packet(sizeof(sGQ_SHUTDOWN_BARRIER_REQ));
+	sGQ_SHUTDOWN_BARRIER_REQ* req = (sGQ_SHUTDOWN_BARRIER_REQ*)packet.GetPacketData();
+	req->wOpCode = GQ_SHUTDOWN_BARRIER_REQ;
+	req->token = token;
+	packet.SetPacketLen(sizeof(sGQ_SHUTDOWN_BARRIER_REQ));
+	// This runs after the world tick removed the final player and LeaveGame queued
+	// every save. The dispatch gate also waits for an in-place handler already
+	// running, then prevents future gameplay handlers and ticks from sending more
+	// work. The barrier uses the same ordered TCP session as those saves.
+	if (app->SendTo(query, &packet) == NTL_SUCCESS)
+	{
+		m_shutdownBarrierSent = true;
+		printf("SHUTDOWN_GAME_BARRIER_SENT token=%llu players=0\n", token);
+		fflush(stdout);
+	}
+}
+
+void CGameProcessor::AcknowledgeShutdownBarrier(UINT64 token, bool success, UINT64 commits, UINT64 failures)
+{
+	if (!m_shutdownStarted.load() || token != m_shutdownToken.load()) return;
+	if (success && failures == 0)
+	{
+		printf("SHUTDOWN_GAME_SAVES_ACK token=%llu commits=%llu failures=0\n", token, commits);
+		fflush(stdout);
+		m_shutdownReady.store(true);
+	}
+	else
+	{
+		printf("SHUTDOWN_GAME_BARRIER_FAILED token=%llu commits=%llu failures=%llu\n", token, commits, failures);
+		fflush(stdout);
+	}
+}
+
+void CGameProcessor::PrintShutdownStatus()
+{
+	printf("GAME_SHUTDOWN_STATUS started=%u disconnected=%u quiesced=%u players=%llu barrier_token=%llu saves_ack=%u save_validation_failed=%u\n",
+		(unsigned)m_shutdownStarted.load(), (unsigned)m_shutdownDisconnected.load(), (unsigned)m_shutdownQuiesced.load(), m_shutdownPlayers.load(),
+		m_shutdownToken.load(), (unsigned)m_shutdownReady.load(), (unsigned)m_saveValidationFailed.load());
+	fflush(stdout);
+}
