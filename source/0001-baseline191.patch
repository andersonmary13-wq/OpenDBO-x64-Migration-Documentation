+            if (!sameOperation()) return false;
+            auto* current=GetNtlSLGlobal()->GetSobAvatar();
+            if (!current || current->GetSerialID()!=avatarSerial) { reconcile();return false; }
+            return true;
+        };
+        const auto detachedDonorValid=[&](const ClientMove& donor) -> bool {
+            const auto found=std::find_if(changes.begin(),changes.end(),[&](const Change& change){return change.move.handle==donor.handle;});
+            auto* sob=GetNtlSobManager()->GetSobObject(donor.handle);
+            if (found==changes.end() || !sob || sob->GetClassID()!=SLCLASS_SLOT_ITEM || sob->GetSerialID()!=donor.handle) return false;
+            auto* item=static_cast<CNtlSobItem*>(sob);
+            auto* attr=static_cast<CNtlSobItemAttr*>(item->GetSobAttr());
+            const auto expected=result.byScope==Bags?CNtlSobItem::SIP_BAG_CHILD:CNtlSobItem::SIP_WAREHOUSE_CHILD;
+            return item->GetParentItemSerial()==INVALID_SERIAL_ID && item->GetItemPosition()==expected
+                && item->GetItemSlotIdx()==donor.from.pos && item->GetChildNum()==0
+                && attr && matchesOriginal(attr,found->original);
+        };
+        for (const auto& donor:donors)
+        {
+            if (!contextCurrent()) return;
+            if (!detachedDonorValid(donor)) { reconcile();return; }
+            // Native GUI subscribers at0x9000 clear borrowed pointers while live.
+            // For BANK, Inventory ignores this event; the Warehouse event follows.
+            CNtlSLEventGenerator::SobItemDelete(avatarSerial,donor.handle,donor.from.place,donor.from.pos);
+            if (!contextCurrent()) return;
+            if (result.byScope==PersonalBank)
+            {
+                const auto expected=originalParents.find(donor.from.place);
+                auto* current=GetNtlSLGlobal()->GetSobAvatar();
+                const auto serial=current->GetWarehouse()->GetSlotSerailID(result.byBankIndex);
+                auto* parentSob=GetNtlSobManager()->GetSobObject(serial);
+                if (!detachedDonorValid(donor) || expected==originalParents.end()
+                    || serial!=expected->second.first || !parentSob || parentSob->GetClassID()!=SLCLASS_SLOT_ITEM)
+                { reconcile();return; }
+                auto* parent=static_cast<CNtlSobItem*>(parentSob);
+                if (parent->GetItemPosition()!=CNtlSobItem::SIP_WAREHOUSE || parent->GetChildNum()!=expected->second.second
+                    || parent->GetChildSerial(donor.from.pos)!=INVALID_SERIAL_ID) { reconcile();return; }
+                CNtlSLEventGenerator::SobWarehouseItemDelete(avatarSerial,donor.handle,donor.from.place,donor.from.pos);
+                if (!contextCurrent()) return;
+            }
+            if (GetNtlSobManager()->GetSobObject(donor.handle)) { reconcile();return; }
+        }
+        if (!contextCurrent()) return;
+        // Native item deletion emits nested visual SobUpdate events. Reacquire and
+        // revalidate every parent and survivor after the complete callback graph.
+        avatar=GetNtlSLGlobal()->GetSobAvatar();
+        if (!buildParents() || parents.size()!=originalParents.size()) { reconcile();return; }
+        for (const auto& entry:parents)
+        {
+            const auto expected=originalParents.find(entry.first);
+            if (expected==originalParents.end() || entry.second->GetSerialID()!=expected->second.first
+                || entry.second->GetChildNum()!=expected->second.second) { reconcile();return; }
+            for (int pos=0;pos<entry.second->GetChildNum();++pos)
+                if (entry.second->GetChildSerial(pos)!=INVALID_SERIAL_ID) { reconcile();return; }
+        }
+        for (auto& change:changes) if (change.move.afterCount)
+        {
+            auto* sob=GetNtlSobManager()->GetSobObject(change.move.handle);
+            const auto from=parents.find(change.move.from.place),to=parents.find(change.move.to.place);
+            if (!sob || sob->GetClassID()!=SLCLASS_SLOT_ITEM || sob->GetSerialID()!=change.move.handle
+                || from==parents.end() || to==parents.end()) { reconcile();return; }
+            auto* item=static_cast<CNtlSobItem*>(sob);
+            const auto expected=result.byScope==Bags?CNtlSobItem::SIP_BAG_CHILD:CNtlSobItem::SIP_WAREHOUSE_CHILD;
+            auto* attr=static_cast<CNtlSobItemAttr*>(item->GetSobAttr());
+            if (item->GetItemPosition()!=expected || item->GetParentItemSerial()!=from->second->GetSerialID()
+                || item->GetItemSlotIdx()!=change.move.from.pos || !attr || !matchesOriginal(attr,change.original)) { reconcile();return; }
+            change.item=item;change.attr=attr;change.to=to->second;
+        }
+        // No more callbacks/allocations/lookups until all survivor links/counts exist.
+        for (const auto& change:changes) if (change.move.afterCount)
+        {
+            change.to->SetChildSerial(change.move.to.pos,change.move.handle);
+            change.item->SetParentItemSerial(change.to->GetSerialID());
+            change.item->SetItemSlotIdx(change.move.to.pos);
+            change.item->SetItemPosition(result.byScope==Bags?CNtlSobItem::SIP_BAG_CHILD:CNtlSobItem::SIP_WAREHOUSE_CHILD);
+            if (change.original.table) change.attr->SetStackNum(change.move.afterCount);
+        }
+        GetDboGlobal()->GetGamePacketGenerator()->ResetInventorySortPending();
+        const RwUInt32 update=EVENT_AIUT_ITEM|(result.byScope==PersonalBank?EVENT_AIUT_WAREHOUSE:0);
+        CNtlSLEventGenerator::SobUpdate(avatarSerial,update,0);
+    }
+    catch (...)
+    {
+        // Allocation/validation failures never release a live uncertain inventory.
+        reconcile();
+    }
+}
