+void CClientSession::RecvSerializedPacket(CNtlPacket* packet)
+{
+    if (!packet || packet->GetPacketDataSize() < sizeof(sNTLPACKETHEADER)) return;
+    if (cPlayer && cPlayer->GetClientSessionID() != GetHandle()) return;
+    const WORD opcode = reinterpret_cast<sNTLPACKETHEADER*>(packet->GetPacketData())->wOpCode;
+    if (cPlayer && cPlayer->GetPlayerItemContainer()->IsInventoryMutationPending())
+    {
+        // Inventory/commercial/quest actions wait for a known persistence
+        // outcome. Ordinary positional updates and the client heartbeat do not
+        // mutate an item and stay available. No automatic retry is performed.
+        switch (opcode)
+        {
+        case UG_CLIENT_INFO_NFY:
+        case UG_CHAR_MOVE:
+        case UG_CHAR_DEST_MOVE:
+        case UG_CHAR_CHANGE_HEADING:
+        case UG_CHAR_TARGET_SELECT:
+        case UG_CHAR_TARGET_FACING:
+        case UG_CHAR_AIR_MOVE:
+        case UG_CHAR_AIR_FALLING:
+        case UG_CHAR_AIR_END:
+            break;
+        default: return;
+        }
+    }
+    const auto* handler = ug_opcodeTable->LookupOpcode(opcode);
+    if (handler) (this->*handler->handler)(packet);
+}
