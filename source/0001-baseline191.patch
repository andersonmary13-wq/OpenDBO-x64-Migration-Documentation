+            start > 0x7fffffffffffffffULL || end > 0x7fffffffffffffffULL) return false;
+        return LocalFuelPreference(static_cast<TBLIDX>(table), static_cast<BYTE>(duration),
+            static_cast<DBOTIME>(start), static_cast<DBOTIME>(end)) == value;
+    }
