+		{
+			PrintWorkStatus();
+			printf("DB_DRAIN_FAILED reason=sql_or_callback_failure worker_kept_alive=1\n");
+			fflush(stdout);
+			return false;
+		}
+		if (status.IsDrained()) break;
+		if (std::chrono::steady_clock::now() >= deadline)
+		{
+			PrintWorkStatus();
+			printf("DB_DRAIN_FAILED reason=timeout worker_kept_alive=1\n");
+			fflush(stdout);
+			return false;
+		}
+		std::this_thread::sleep_for(std::chrono::milliseconds(1));
+	}
+	s_IsQuit = true;
+	s_cond.notify_all();
+	if (s_pThread)
+	{
+		s_pThread->join();
+		delete s_pThread;
+		s_pThread = nullptr;
+	}
+	PrintWorkStatus();
+	printf("DB_DRAIN_COMPLETE pending=0 failures=0 worker_joined=1\n");
+	fflush(stdout);
+	return true;
