+void CCharServer::UpdateShutdown()
+{
+	// The app tick holds the same work gate as every network gameplay handler.
+	if (!m_shutdownWork.requested.load()) return;
+	if (!m_shutdownWork.quiesced.load())
+	{
+		if (!Database::IsAllWorkDrained()) return;
+		m_shutdownWork.quiesced.store(true);
+		printf("SHUTDOWN_QUERY_QUIESCED service=CharServer gameplay_handlers_blocked=1\n");
+		fflush(stdout);
+	}
+	if (m_shutdownWork.sent) return;
+	CQueryServerSession* query = GetQueryServerSession();
+	if (!query || !query->IsConnected()) return; // Fail closed if Query is unavailable.
+	const UINT64 token = (GetTickCount64() << 16) ^ (UINT64)GetCurrentProcessId();
+	m_shutdownWork.token.store(token);
+	CNtlPacket packet(sizeof(sCQ_SHUTDOWN_BARRIER_REQ));
+	sCQ_SHUTDOWN_BARRIER_REQ* req = (sCQ_SHUTDOWN_BARRIER_REQ*)packet.GetPacketData();
+	req->wOpCode = CQ_SHUTDOWN_BARRIER_REQ;
+	req->token = token;
+	packet.SetPacketLen(sizeof(sCQ_SHUTDOWN_BARRIER_REQ));
+	if (SendTo(query, &packet) == NTL_SUCCESS)
+	{
+		m_shutdownWork.sent = true;
+		printf("SHUTDOWN_QUERY_BARRIER_SENT service=CharServer token=%llu\n", token);
+		fflush(stdout);
@@ -246,0 +294 @@
+	CNtlServerAppLifecycleGuard lifecycleGuard(app);
@@ -254 +302 @@
-		return rc;
+		{ app.Stop(); app.WaitForTerminate(); return rc; }
@@ -306,3 +354,5 @@
-
-
-	app.Start();
+	app.SetShutdownHooks(&Database::IsAllWorkDrained, &Database::PrintWorkStatus, []() { return Database::DrainAndStop(120000); });
+
+
+	const int startResult = app.Start();
+	if (startResult != NTL_SUCCESS) { app.WaitForTerminate(); return startResult; }
