+RwBool CWorldMapGui::IsGenericNpcSearchName(const std::wstring& name)
+{
+	const std::wstring::size_type first = name.find_first_not_of(L" \t\r\n");
+	if (first == std::wstring::npos)
+		return FALSE;
+	const WCHAR prefix[] = L"citizen";
+	std::wstring::size_type i = first;
+	for (size_t p = 0; p < 7; ++p, ++i)
+	{
+		if (i == name.size()) return FALSE;
+		WCHAR c = name[i];
+		if (c >= L'A' && c <= L'Z') c += L'a' - L'A';
+		if (c != prefix[p]) return FALSE;
+	}
+	i = name.find_first_not_of(L" \t\r\n", i);
+	if (i == std::wstring::npos || name[i] < L'0' || name[i] > L'9')
+		return FALSE;
+	while (i < name.size() && name[i] >= L'0' && name[i] <= L'9') ++i;
+	return name.find_first_not_of(L" \t\r\n", i) == std::wstring::npos;
+}
