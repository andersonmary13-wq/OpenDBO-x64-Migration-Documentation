+	const UINT32 second = (peer >> 16) & 255;
+	const bool loopback = first == 127;
+	const bool privatePeer = first == 10 || (first == 172 && second >= 16 && second <= 31) || (first == 192 && second == 168);
+	const UINT32 localFirst = local >> 24;
+	if ((loopback || privatePeer) && localFirst != 0 && localFirst < 224 &&
+		(localFirst != 127 || loopback) && local != 0xFFFFFFFF)
+	{
+		char address[16];
+		sprintf_s(address, sizeof(address), "%u.%u.%u.%u", localFirst, (local >> 16) & 255, (local >> 8) & 255, local & 255);
+		return address;
+	}
+	return advertised ? advertised : "";
+}
+
+std::string CNtlSession::GetPlayerEndpointIPv4(const char* advertised)
+{
+	const UINT32 peerNetworkOrder = GetRemoteAddr().GetAddr();
+	CNtlSockAddr actualLocal;
+	const int socketStatus = GetSocket().GetLocalAddr(actualLocal);
+	std::string selected;
+	const char* source = "canonical";
+	if (socketStatus == NTL_SUCCESS)
+	{
+		selected = SelectPlayerEndpointIPv4(NULL, peerNetworkOrder, actualLocal.GetAddr());
+		if (!selected.empty()) source = "socket";
+	}
+	if (selected.empty())
+	{
+		// AcceptEx exposes these addresses through GetAcceptExSockaddrs before
+		// getsockname is usable. CompleteAccept already saved both in SetAddress.
+		selected = SelectPlayerEndpointIPv4(NULL, peerNetworkOrder, GetLocalAddr().GetAddr());
+		if (!selected.empty()) source = "session_cache";
+	}
+	if (selected.empty()) selected = advertised ? advertised : "";
+	const UINT32 peer = ntohl(peerNetworkOrder);
+	NTL_PRINT(PRINT_SYSTEM, "PLAYER_ENDPOINT source=%s peer=%u.%u.%u.%u selected=%s getsockname_status=%d",
+		source, peer >> 24, (peer >> 16) & 255, (peer >> 8) & 255, peer & 255, selected.c_str(), socketStatus);
+	return selected;
+}
