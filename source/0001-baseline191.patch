+VOID CWorldMapGui::OnSelectedNpcWorld(RwInt32 index)
+{
+    OnNpcSelectorToggled(FALSE, NULL);
+    if (!m_bUpdatingMapSelectors && m_pcbbSearchWorld && m_pcbbSearchWorld->GetListBox() && index >= 0 &&
+        index < m_pcbbSearchWorld->GetListBox()->GetItemCount() && static_cast<size_t>(index) < m_vecNpcWorldChoices.size() &&
+        m_pcbbSearchWorld->GetItemData(index) == m_vecNpcWorldChoices[index])
+        SelectNpcMap(m_vecNpcWorldChoices[index], INVALID_TBLIDX);
+}
+VOID CWorldMapGui::OnSelectedNpcZone(RwInt32 index)
+{
+    OnNpcSelectorToggled(FALSE, NULL);
+    if (!m_bUpdatingMapSelectors && m_pcbbSearchZone && m_pcbbSearchZone->GetListBox() && index >= 0 &&
+        index < m_pcbbSearchZone->GetListBox()->GetItemCount() && static_cast<size_t>(index) < m_vecNpcZoneChoices.size() &&
+        m_pcbbSearchZone->GetItemData(index) == m_vecNpcZoneChoices[index])
+        SelectNpcMap(m_vecNpcZoneChoices[index], INVALID_TBLIDX);
+}
+VOID CWorldMapGui::OnSelectedNpcArea(RwInt32 index)
+{
+    OnNpcSelectorToggled(FALSE, NULL);
+    if (!m_bUpdatingMapSelectors && m_pcbbSearchCity && m_pcbbSearchCity->GetListBox() && index >= 0 &&
+        index < m_pcbbSearchCity->GetListBox()->GetItemCount() && static_cast<size_t>(index) < m_vecNpcAreaChoices.size() &&
+        m_pcbbSearchCity->GetItemData(index) == static_cast<DWORD>(index))
+    {
+        const sNPC_AREA_CHOICE choice = m_vecNpcAreaChoices[index];
+        SelectNpcMap(choice.map, choice.area);
+    }
+}
