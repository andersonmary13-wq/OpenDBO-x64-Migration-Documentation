+RwBool CWorldMapGui::ProjectNpcSearchPosition(const RwV3d& vPos, RwInt32& iX, RwInt32& iY)
+{
+	if (!_finite(vPos.x) || !_finite(vPos.y) || !_finite(vPos.z) ||
+		!_finite(m_v2MapPos.x) || !_finite(m_v2MapPos.y) ||
+		!_finite(m_fMapScale) || m_fMapScale <= 0.f)
+		return FALSE;
+
+	// Reject out-of-map coordinates before the existing projection narrows to int.
+	double fX = (static_cast<double>(m_v2MapPos.x) - vPos.x) * m_fMapScale;
+	double fY = (static_cast<double>(m_v2MapPos.y) - vPos.z) * m_fMapScale;
+	if (!_finite(fX) || !_finite(fY) || fX < dMAPADJUST_INMAP ||
+		fX > dMAP_WIDTH - dMAPADJUST_INMAP || fY < dMAPADJUST_INMAP ||
+		fY > dMAP_HEIGHT - dMAPADJUST_INMAP)
+		return FALSE;
+
+	GetMapPos_from_RealPos(vPos.x, vPos.z, iX, iY);
+	return IsinMap(iX, iY);
+}
