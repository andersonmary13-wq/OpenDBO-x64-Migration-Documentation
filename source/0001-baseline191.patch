+namespace
+{
+    // Unique across characters in one Game process, including reconnect/reuse.
+    // Separate Game sessions use separate Query TCP sessions. Never derive from IDs.
+    std::atomic<UINT64> s_inventoryMutationSequence{1};
+}
+
+UINT64 CPlayerItemContainer::BeginInventoryMutation(InventoryMutationKind kind)
+{
+    std::unique_lock<std::mutex> admission(m_inventoryMutationAdmission, std::try_to_lock);
+    if (!admission.owns_lock() || IsInventoryMutationPending() || !m_pOwner || !m_pOwner->IsInitialized()
+        || m_pOwner->IsLoggedOut() || m_pOwner->IsLeaving() || m_pOwner->IsTrading() || m_pOwner->HasPrivateShop()
+        || !m_pOwner->GetCurWorld() || m_pOwner->GetCurWorld()->GetRuleType() != GAMERULE_NORMAL
+        || m_pOwner->GetItemCast() != INVALID_HOBJECT || m_pOwner->GetDragonballScramble()
+        || m_pOwner->GetDragonballScrambleBallFlag() != 0 || m_pOwner->GetTMQ()
+        || m_pOwner->IsDirectPlay() || m_pOwner->IsFainting() || m_pOwner->IsSkillAffecting()
+        || m_pOwner->IsKeepingEffect() || !m_vecReservedInventory.empty()
+        || (kind != INVENTORY_MUTATION_SORT && kind != INVENTORY_MUTATION_COUPON && kind != INVENTORY_MUTATION_STACK_SORT)) return 0;
+    // Covers outstanding Query replies before beginning: both locked equipment
+    // and reserved empty destinations matter, even if outside the sorted bank.
+    for (const auto* map : {&m_map_CharItems, &m_map_BankItems})
+        for (const auto& pair : *map)
+            if (!pair.second || pair.second->IsLocked(false) || pair.second->IsTrading()) return 0;
+    UINT64 token = s_inventoryMutationSequence.load();
+    for (;;)
+    {
+        if (token == 0 || token == UINT64_MAX) return 0;
+        if (s_inventoryMutationSequence.compare_exchange_weak(token, token + 1)) break;
+    }
+    m_inventoryMutationKind = kind;
+    m_inventoryMutationToken = token;
+    m_inventoryMutationUncertain = false;
+    m_inventoryMutationActive.store(true);
+    return token;
+}
+
+bool CPlayerItemContainer::MatchesInventoryMutation(InventoryMutationKind kind, UINT64 token) const
+{
+    return token != 0 && IsInventoryMutationPending()
+        && m_inventoryMutationKind == kind && m_inventoryMutationToken == token;
+}
+
+bool CPlayerItemContainer::EndInventoryMutation(InventoryMutationKind kind, UINT64 token)
+{
+    std::lock_guard<std::mutex> admission(m_inventoryMutationAdmission);
+    if (!MatchesInventoryMutation(kind, token)) return false;
+    m_inventoryMutationToken = 0;
+    m_inventoryMutationKind = INVENTORY_MUTATION_NONE;
+    m_inventoryMutationUncertain = false;
+    m_inventoryMutationActive.store(false);
+    return true;
+}
+
+void CPlayerItemContainer::MarkInventoryMutationUncertain(InventoryMutationKind kind, UINT64 token)
+{
+    if (MatchesInventoryMutation(kind, token) && !m_inventoryMutationUncertain)
+    {
+        m_inventoryMutationUncertain = true;
+        printf("INVENTORY_MUTATION_UNCERTAIN kind=%u token=%llu locks_kept=1\n", unsigned(kind), token);
+        fflush(stdout);
+    }
+}
+
+bool CPlayerItemContainer::TryImmediateInventoryAccess(std::unique_lock<std::mutex>& access)
+{
+    access = std::unique_lock<std::mutex>(m_inventoryMutationAdmission, std::try_to_lock);
+    return access.owns_lock() && !IsInventoryMutationPending();
+}
+
+void CPlayerItemContainer::SendInventorySortResult(BYTE status)
+{
+    CNtlPacket packet(sizeof(sGU_INVENTORY_SORT_ATOMIC_RES));
+    auto* result = reinterpret_cast<sGU_INVENTORY_SORT_ATOMIC_RES*>(packet.GetPacketData());
+    memset(result, 0, sizeof(*result));
+    result->wOpCode = GU_INVENTORY_SORT_ATOMIC_RES;
+    result->token = m_sortClientToken;
+    result->byScope = m_sortScope;
+    result->byBankIndex = m_sortBankIndex;
+    result->byStatus = status;
+    if (status == NtlInventorySort::Ok)
+    {
+        result->wCount = static_cast<WORD>(m_sortMoves.size());
+        for (size_t i = 0; i < m_sortMoves.size(); ++i)
+            result->moves[i] = {m_sortMoves[i].handle, m_sortMoves[i].from, m_sortMoves[i].to};
+    }
+    packet.SetPacketLen(sizeof(*result));
+    m_pOwner->SendPacket(&packet); // A closed client does not prevent reconciliation.
+}
+
+void CPlayerItemContainer::ReleaseInventorySort()
+{
+    for (HOBJECT handle : m_sortLockedHandles)
+    {
+        CItem* item = GetItem(handle);
+        if (!item) item = GetBankItem(handle);
+        if (item) item->SetLocked(false);
+    }
+    for (const auto& cell : m_sortReservedCells) RemoveReservedInventory(cell.place, cell.pos);
+    m_sortMoves.clear(); m_sortLockedHandles.clear(); m_sortReservedCells.clear();
+}
