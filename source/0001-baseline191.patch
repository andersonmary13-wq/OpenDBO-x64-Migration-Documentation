diff --git a/DboClient/Lib/NtlSimulation/NtlPetUseTrace.h b/DboClient/Lib/NtlSimulation/NtlPetUseTrace.h
new file mode 100644
--- /dev/null
+++ b/DboClient/Lib/NtlSimulation/NtlPetUseTrace.h
@@ -0,0 +1,59 @@
+#pragma once
+
+// DBO-026 diagnostic only. No identifiers, text from the game or persistent state.
+// Kept outside the shared PCH. One process-local cap, including all call sites.
+#include <windows.h>
+#include <stdio.h>
+
+namespace NtlPetUseTrace
+{
+    enum Stage
+    {
+        BAG_ENTRY = 1, BAG_ICON_MOVE = 2, BAG_ROUTE = 3, BAG_NOT_USABLE = 4,
+        USE_PROC = 10, USE_SUB = 11, USE_COMM_BLOCKED = 12,
+        USE_VEHICLE_BLOCKED = 14, USE_SPECIAL_RESULT = 15, USE_ICON_REJECT = 16,
+        ICON_POSSIBLE = 20, ICON_POSSIBLE_REJECT = 21,
+        ICON_STATE = 22, ICON_POSSIBLE_PASS = 23,
+        ICON_USE = 30, ICON_USE_REJECT = 31, ICON_ACTION_MAP = 32,
+        FSM_NOTIFY = 40, FSM_SEND_RESULT = 41,
+        PACKET_ENTER = 50, PACKET_LOCKED = 51,
+        PACKET_LOCK_ACQUIRED = 52, PACKET_SEND_RESULT = 53,
+        ITEM_USE_RESPONSE = 60, MASCOT_REGISTER_NOTIFY = 61
+    };
+
+    // The named constants are supplied by the callers' existing item table enum.
+    template <class T> inline bool Matches(const T* item, unsigned int mascotBodyType, unsigned int newMascotType)
+    {
+        return ::IsDebuggerPresent() && item &&
+            (item->tblidx == 6000068u || item->byItem_Type == mascotBodyType ||
+             item->byItem_Type == newMascotType);
+    }
+
+    inline void Emit(Stage stage, unsigned __int64 a = 0, unsigned __int64 b = 0,
+                     unsigned __int64 c = 0, unsigned __int64 d = 0)
+    {
+        if (!::IsDebuggerPresent())
+            return;
+        static volatile LONG count = 0;
+        LONG observed = ::InterlockedCompareExchange(&count, 0, 0);
+        for (;;)
+        {
+            if (observed > 512)
+                return;
+            LONG previous = ::InterlockedCompareExchange(&count, observed + 1, observed);
+            if (previous == observed)
+                break;
+            observed = previous;
+        }
+        if (observed == 512)
+        {
+            ::OutputDebugStringA("[PETUSE026] TRACE_LIMIT\n");
+            return;
+        }
+        char line[192];
+        _snprintf_s(line, sizeof(line), _TRUNCATE,
+                    "[PETUSE026] stage=%u a=%I64u b=%I64u c=%I64u d=%I64u\n",
+                    static_cast<unsigned int>(stage), a, b, c, d);
+        ::OutputDebugStringA(line);
+    }
+}
