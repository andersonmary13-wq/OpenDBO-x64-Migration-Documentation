+
+AtomicDbOutcome CItemRepository::ApplyUpgradeCouponAtomic(CHARACTERID charId,
+    const sITEM_DATA& equipment, const sITEM_DATA& coupon, BYTE grade,
+    DBOTIME start, DBOTIME end, BYTE restrictState, BYTE durationType)
+{
+    if (!charId || charId == INVALID_CHARACTERID || equipment.itemId == coupon.itemId ||
+        equipment.itemId == INVALID_ITEMID || coupon.itemId == INVALID_ITEMID ||
+        equipment.charId != charId || coupon.charId != charId ||
+        equipment.byPlace < CONTAINER_TYPE_BAG1 || equipment.byPlace > CONTAINER_TYPE_BAG5 ||
+        coupon.byPlace < CONTAINER_TYPE_BAG1 || coupon.byPlace > CONTAINER_TYPE_BAG5 ||
+        equipment.byPosition >= NTL_MAX_BAG_ITEM_SLOT || coupon.byPosition >= NTL_MAX_BAG_ITEM_SLOT ||
+        (equipment.byPlace == coupon.byPlace && equipment.byPosition == coupon.byPosition) ||
+        equipment.byStackcount != 1 || equipment.byGrade != 0 || equipment.bNeedToIdentify || coupon.bNeedToIdentify ||
+        equipment.byRestrictState != ITEM_RESTRICT_STATE_TYPE_NONE ||
+        equipment.byDurationType != eDURATIONTYPE_NORMAL || coupon.byStackcount == 0 ||
+        grade == 0 || grade > NTL_ITEM_MAX_GRADE || start <= 0 || end <= start ||
+        end > 0xffffffffu || restrictState != ITEM_RESTRICT_STATE_TYPE_CHARACTER_GET ||
+        durationType != eDURATIONTYPE_FLATSUM)
+        return AtomicDbOutcome::RolledBack;
+
+    return GetCharDB.TryAtomic([&](DatabaseAtomicTransaction& tx) -> bool
+    {
+        // Only numeric server/cache fields are formatted. No caller-provided SQL,
+        // names or strings are interpolated. Row order also gives a stable lock order.
+        std::ostringstream select;
+        select.imbue(std::locale::classic());
+        select << "SELECT id,tblidx,char_id,place,pos,count,grade,need_to_identify,restrict_state,duration_type,use_start_time,use_end_time FROM items WHERE id IN ("
+            << equipment.itemId << ',' << coupon.itemId << ") ORDER BY id FOR UPDATE";
+        QueryResult* raw = NULL;
+        if (!tx.Query(select.str(), raw)) return false;
+        std::unique_ptr<QueryResult> rows(raw);
+        if (!rows || rows->GetRowCount() != 2 || rows->GetFieldCount() != 12) return false;
+        bool seenEquipment = false, seenCoupon = false;
+        do
+        {
+            Field* f = rows->Fetch();
+            if (!f) return false;
+            const ITEMID id = f[0].GetUInt64();
+            const sITEM_DATA* expected = NULL;
+            if (id == equipment.itemId && !seenEquipment) { expected = &equipment; seenEquipment = true; }
+            else if (id == coupon.itemId && !seenCoupon) { expected = &coupon; seenCoupon = true; }
+            else return false;
+            if (f[1].GetUInt32() != expected->itemNo || f[2].GetUInt32() != charId ||
+                f[3].GetUInt32() != expected->byPlace || f[4].GetUInt32() != expected->byPosition ||
+                f[5].GetUInt32() != expected->byStackcount || f[6].GetUInt32() != expected->byGrade ||
+                f[7].GetBool() != expected->bNeedToIdentify || f[8].GetUInt32() != expected->byRestrictState ||
+                f[9].GetUInt32() != expected->byDurationType ||
+                f[10].GetUInt64() != static_cast<UINT64>(expected->nUseStartTime) ||
+                f[11].GetUInt64() != static_cast<UINT64>(expected->nUseEndTime)) return false;
+        } while (rows->NextRow());
+        if (!seenEquipment || !seenCoupon) return false;
+        rows.reset();
+
+        std::ostringstream update;
+        update.imbue(std::locale::classic());
+        update << "UPDATE items SET grade=" << unsigned(grade) << ",use_start_time=" << start
+            << ",use_end_time=" << end << ",restrict_state=" << unsigned(restrictState)
+            << ",duration_type=" << unsigned(durationType) << " WHERE id=" << equipment.itemId
+            << " AND char_id=" << charId << " AND place=" << unsigned(equipment.byPlace)
+            << " AND pos=" << unsigned(equipment.byPosition) << " AND grade=0";
+        if (!tx.ExecuteExact(update.str(), 1)) return false;
+
+        std::ostringstream consume;
+        consume.imbue(std::locale::classic());
+        if (coupon.byStackcount == 1) consume << "DELETE FROM items";
+        else consume << "UPDATE items SET count=" << unsigned(coupon.byStackcount - 1);
+        consume << " WHERE id=" << coupon.itemId << " AND char_id=" << charId
+            << " AND place=" << unsigned(coupon.byPlace) << " AND pos=" << unsigned(coupon.byPosition)
+            << " AND count=" << unsigned(coupon.byStackcount);
+        return tx.ExecuteExact(consume.str(), 1);
+    });
+}
+
+AtomicDbOutcome CItemRepository::ApplyInventorySortAtomic(CHARACTERID charId, BYTE scope, BYTE bankIndex,
+    const std::vector<sITEM_DATA>& snapshot, const std::vector<NtlInventorySort::Move>& moves)
+{
+    using namespace NtlInventorySort;
+    if (!charId || charId == INVALID_CHARACTERID || snapshot.size() != moves.size() || moves.size() > MaxItems
+        || !((scope == Bags && bankIndex == 255) || (scope == PersonalBank && bankIndex < 3)))
+        return AtomicDbOutcome::RolledBack;
+    std::map<ITEMID, const sITEM_DATA*> expected;
+    std::set<Cell> sourceCells, destinationCells;
+    std::set<HOBJECT> handles;
+    for (const auto& item : snapshot)
+    {
+        if (item.charId != charId || item.itemId == 0 || item.itemId == INVALID_ITEMID || !item.byStackcount
+            || !expected.emplace(item.itemId, &item).second) return AtomicDbOutcome::RolledBack;
+    }
+    for (const auto& move : moves)
+    {
+        const auto found = expected.find(move.itemId);
+        if (found == expected.end() || move.handle == INVALID_HOBJECT || !handles.insert(move.handle).second
+            || !sourceCells.insert(move.from).second || !destinationCells.insert(move.to).second)
+            return AtomicDbOutcome::RolledBack;
+        const auto& item = *found->second;
+        const auto valid = [&](Cell cell) {
+            return scope == Bags ? cell.place >= CONTAINER_TYPE_BAG1 && cell.place <= CONTAINER_TYPE_BAG5 && cell.pos < 32
+                : cell.place == CONTAINER_TYPE_BANK1 + bankIndex && cell.pos < 16;
+        };
+        if (!valid(move.from) || !valid(move.to) || item.byPlace != move.from.place || item.byPosition != move.from.pos
+            || item.itemNo != move.tableId || item.byStackcount != move.count || item.byRank != move.rank || item.byGrade != move.grade)
+            return AtomicDbOutcome::RolledBack;
+    }
+    return GetCharDB.TryAtomic([&](DatabaseAtomicTransaction& tx) -> bool
+    {
+        // Lock the COMPLETE ownership domain, including rows absent from a stale cache.
+        // No names, account input or arbitrary SQL enters these numeric predicates.
+        std::ostringstream select;
+        select.imbue(std::locale::classic());
+        select << "SELECT id,tblidx,char_id,place,pos,count,`rank`,grade,account_id,guild_id FROM items WHERE char_id=" << charId;
+        if (scope == Bags) select << " AND place BETWEEN 1 AND 5";
+        else select << " AND place=" << unsigned(CONTAINER_TYPE_BANK1 + bankIndex);
+        select << " ORDER BY id FOR UPDATE";
+        QueryResult* raw = nullptr;
+        if (!tx.Query(select.str(), raw)) return false;
+        std::unique_ptr<QueryResult> rows(raw);
+        if (snapshot.empty()) return !rows;
+        if (!rows || rows->GetRowCount() != snapshot.size() || rows->GetFieldCount() != 10) return false;
+        std::set<ITEMID> seen;
+        do
+        {
+            Field* fields = rows->Fetch();
+            if (!fields) return false;
+            const ITEMID id = fields[0].GetUInt64();
+            const auto found = expected.find(id);
+            if (found == expected.end() || !seen.insert(id).second) return false;
+            const auto& item = *found->second;
+            if (fields[1].GetUInt32() != item.itemNo || fields[2].GetUInt32() != charId
+                || fields[3].GetUInt32() != item.byPlace || fields[4].GetUInt32() != item.byPosition
+                || fields[5].GetUInt32() != item.byStackcount || fields[6].GetUInt32() != item.byRank
+                || fields[7].GetUInt32() != item.byGrade || fields[8].GetUInt32() != 0 || fields[9].GetUInt32() != 0)
+                return false;
+        } while (rows->NextRow());
+        if (seen.size() != expected.size()) return false;
+        rows.reset();
+        std::vector<const Move*> changed;
+        for (const auto& move : moves) if (!(move.from == move.to)) changed.push_back(&move);
+        if (changed.empty()) return true;
+        // One CASE UPDATE: never persist parking cells, merge stacks, or remove rows.
+        // A schema constraint rejecting a cycle causes a rollback, not a workaround.
+        std::ostringstream update;
+        update.imbue(std::locale::classic());
+        update << "UPDATE items SET place=CASE id";
+        for (const auto* move : changed) update << " WHEN " << move->itemId << " THEN " << unsigned(move->to.place);
+        update << " ELSE place END,pos=CASE id";
+        for (const auto* move : changed) update << " WHEN " << move->itemId << " THEN " << unsigned(move->to.pos);
+        update << " ELSE pos END WHERE char_id=" << charId << " AND account_id=0 AND guild_id=0 AND (";
+        bool first = true;
+        for (const auto* move : changed)
+        {
+            if (!first) update << " OR "; first = false;
+            update << "(id=" << move->itemId << " AND place=" << unsigned(move->from.place)
+                << " AND pos=" << unsigned(move->from.pos) << " AND tblidx=" << move->tableId
+                << " AND count=" << unsigned(move->count) << " AND `rank`=" << unsigned(move->rank)
+                << " AND grade=" << unsigned(move->grade) << ')';
+        }
+        update << ')';
+        return tx.ExecuteExact(update.str(), static_cast<UINT64>(changed.size()));
+    });
+}
+
+
+AtomicDbOutcome CItemRepository::ApplyInventoryStackSortAtomic(CHARACTERID charId, BYTE scope, BYTE bankIndex,
+    const std::vector<sITEM_DATA>& snapshot, const std::vector<NtlInventoryStackSort::Move>& moves)
+{
+    using namespace NtlInventoryStackSort;
+    if (!charId || charId == INVALID_CHARACTERID
+        || !((scope == Bags && bankIndex == 255) || (scope == PersonalBank && bankIndex < 3))
+        || !ValidatePlan(static_cast<Scope>(scope), bankIndex, snapshot, moves)) return AtomicDbOutcome::RolledBack;
+    std::map<ITEMID, const sITEM_DATA*> expected;
+    for (const auto& item : snapshot)
+    {
+        if (item.charId != charId
+            || std::find(item.awchMaker, item.awchMaker + NTL_MAX_SIZE_CHAR_NAME + 1, WCHAR(0)) == item.awchMaker + NTL_MAX_SIZE_CHAR_NAME + 1)
+            return AtomicDbOutcome::RolledBack;
+        expected.emplace(item.itemId, &item);
+    }
+    return GetCharDB.TryAtomic([&](DatabaseAtomicTransaction& tx) -> bool
+    {
+        // Lock the COMPLETE personal ownership domain, not just the submitted IDs.
+        // Compare every persisted attribute before any DELETE/UPDATE. Maker is
+        // read for comparison only and is never formatted into an SQL statement.
+        std::ostringstream select;
+        select.imbue(std::locale::classic());
+        select << "SELECT id,tblidx,char_id,place,pos,count,`rank`,durability,grade,need_to_identify,battle_attribute,maker,"
+            "option_tblidx,option_tblidx_2,option_random_id,option_random_val,option_random_id_2,option_random_val_2,"
+            "option_random_id_3,option_random_val_3,option_random_id_4,option_random_val_4,option_random_id_5,option_random_val_5,"
+            "option_random_id_6,option_random_val_6,option_random_id_7,option_random_val_7,option_random_id_8,option_random_val_8,"
+            "use_start_time,use_end_time,restrict_state,duration_type,account_id,guild_id FROM items WHERE char_id=" << charId;
+        if (scope == Bags) select << " AND place BETWEEN 1 AND 5";
+        else select << " AND place=" << unsigned(CONTAINER_TYPE_BANK1 + bankIndex);
+        select << " ORDER BY id FOR UPDATE";
+        QueryResult* raw = nullptr;
+        if (!tx.Query(select.str(), raw)) return false;
+        std::unique_ptr<QueryResult> rows(raw);
+        if (snapshot.empty()) return !rows;
+        if (!rows || rows->GetRowCount() != snapshot.size() || rows->GetFieldCount() != 36) return false;
+        std::set<ITEMID> seen;
+        do
+        {
+            Field* f = rows->Fetch();
+            if (!f) return false;
+            const ITEMID id = f[0].GetUInt64();
+            const auto found = expected.find(id);
+            if (found == expected.end() || !seen.insert(id).second) return false;
+            const auto& item = *found->second;
+            if (f[1].GetUInt32() != item.itemNo || f[2].GetUInt32() != charId
+                || f[3].GetUInt32() != item.byPlace || f[4].GetUInt32() != item.byPosition
+                || f[5].GetUInt32() != item.byStackcount || f[6].GetUInt32() != item.byRank
+                || f[7].GetUInt32() != item.byCurrentDurability || f[8].GetUInt32() != item.byGrade
+                || f[9].GetBool() != item.bNeedToIdentify || f[10].GetUInt32() != item.byBattleAttribute
+                || f[30].GetUInt64() != static_cast<UINT64>(item.nUseStartTime)
+                || f[31].GetUInt64() != static_cast<UINT64>(item.nUseEndTime)
+                || f[32].GetUInt32() != item.byRestrictState || f[33].GetUInt32() != item.byDurationType
+                || f[34].GetUInt32() != 0 || f[35].GetUInt32() != 0) return false;
+            const std::wstring maker = s2ws(f[11].GetString());
+            if (maker.size() > NTL_MAX_SIZE_CHAR_NAME || maker != item.awchMaker) return false;
+            for (size_t i = 0; i < NTL_MAX_OPTION_IN_ITEM; ++i)
+                if (f[12 + i].GetUInt32() != item.sOptionSet.aOptionTblidx[i]) return false;
+            for (size_t i = 0; i < NTL_MAX_RANDOM_OPTION_IN_ITEM; ++i)
+                if (f[14 + i * 2].GetUInt32() != item.sOptionSet.aRandomOption[i].wOptionIndex
+                    || f[15 + i * 2].GetUInt32() != static_cast<UINT32>(item.sOptionSet.aRandomOption[i].optionValue)) return false;
+        } while (rows->NextRow());
+        if (seen.size() != expected.size()) return false;
+        rows.reset();
+        std::vector<const Move*> deleted, changed;
+        for (const auto& move : moves)
+        {
+            if (!move.afterCount) deleted.push_back(&move);
+            else if (!(move.from == move.to) || move.count != move.afterCount) changed.push_back(&move);
+        }
+        if (!deleted.empty())
+        {
+            std::ostringstream erase;
+            erase.imbue(std::locale::classic());
+            erase << "DELETE FROM items WHERE char_id=" << charId << " AND account_id=0 AND guild_id=0 AND (";
+            bool first = true;
+            for (const auto* move : deleted)
+            {
+                if (!first) erase << " OR "; first = false;
+                erase << "(id=" << move->itemId << " AND place=" << unsigned(move->from.place)
+                    << " AND pos=" << unsigned(move->from.pos) << " AND count=" << unsigned(move->count) << ')';
+            }
+            erase << ')';
+            if (!tx.ExecuteExact(erase.str(), static_cast<UINT64>(deleted.size()))) return false;
+        }
+        if (changed.empty()) return true;
+        std::ostringstream update;
+        update.imbue(std::locale::classic());
+        update << "UPDATE items SET place=CASE id";
+        for (const auto* move : changed) update << " WHEN " << move->itemId << " THEN " << unsigned(move->to.place);
+        update << " ELSE place END,pos=CASE id";
+        for (const auto* move : changed) update << " WHEN " << move->itemId << " THEN " << unsigned(move->to.pos);
+        update << " ELSE pos END,count=CASE id";
+        for (const auto* move : changed) update << " WHEN " << move->itemId << " THEN " << unsigned(move->afterCount);
+        update << " ELSE count END WHERE char_id=" << charId << " AND account_id=0 AND guild_id=0 AND (";
+        bool first = true;
+        for (const auto* move : changed)
+        {
+            if (!first) update << " OR "; first = false;
+            update << "(id=" << move->itemId << " AND place=" << unsigned(move->from.place)
+                << " AND pos=" << unsigned(move->from.pos) << " AND count=" << unsigned(move->count) << ')';
+        }
+        update << ')';
+        return tx.ExecuteExact(update.str(), static_cast<UINT64>(changed.size()));
+    });
+}
