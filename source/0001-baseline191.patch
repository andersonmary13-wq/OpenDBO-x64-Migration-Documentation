+    // Diagnostic only: invoked by two real capsule-use rejection branches.
+    void TraceVehicleDenial24(unsigned int gate, CNtlSob* source, CNtlSobAvatar* avatar, unsigned int result)
+    {
+        if (!::IsDebuggerPresent() || !source || source->GetClassID() != SLCLASS_SLOT_ITEM)
+            return;
+        try
+        {
+            CNtlSobItemAttr* attr = reinterpret_cast<CNtlSobItemAttr*>(source->GetSobAttr());
+            sITEM_TBLDAT* item = attr ? attr->GetItemTbl() : NULL;
+            if (!item || item->byItem_Type != ITEM_TYPE_CAPSULE) return;
+            static volatile LONG count = 0;
+            LONG observed = ::InterlockedCompareExchange(&count, 0, 0);
+            for (;;)
+            {
+                if (observed >= 64) return;
+                LONG previous = ::InterlockedCompareExchange(&count, observed + 1, observed);
+                if (previous == observed) break;
+                observed = previous;
+            }
+            sUSE_ITEM_TBLDAT* use = NULL;
+            if (API_GetTableContainer() && API_GetTableContainer()->GetUseItemTable())
+                use = reinterpret_cast<sUSE_ITEM_TBLDAT*>(API_GetTableContainer()->GetUseItemTable()->FindData(item->Use_Item_Tblidx));
+            sCHARSTATE* state = avatar ? avatar->GetServerFullState() : NULL;
+            sASPECTSTATE* aspect = avatar ? avatar->GetAspectState() : NULL;
+            CNtlBeCharData* behavior = avatar ? reinterpret_cast<CNtlBeCharData*>(avatar->GetBehaviorData()) : NULL;
+            CNtlFSMStateBase* fsm = avatar ? avatar->GetCurrentState() : NULL;
+            char line[512];
+            _snprintf_s(line, sizeof(line), _TRUNCATE,
+                "[VEHICLE24] tick=%I64u seq=%ld gate=%u item=%u use=%u need=%u result=%u state_present=%u server_state=%u server_air=%u aspect=%u condition=%I64u client_air=%u swim=%u jump=%u fsm=%u\n",
+                ::GetTickCount64(), observed + 1, gate, static_cast<unsigned int>(item->tblidx),
+                static_cast<unsigned int>(item->Use_Item_Tblidx), use ? static_cast<unsigned int>(use->wNeed_State_Bit_Flag) : 65535u,
+                result, state ? 1u : 0u, state ? static_cast<unsigned int>(state->sCharStateBase.byStateID) : 255u,
+                state ? static_cast<unsigned int>(state->sCharStateBase.eAirState) : 255u,
+                aspect ? static_cast<unsigned int>(aspect->sAspectStateBase.byAspectStateId) : 255u,
+                state ? static_cast<unsigned __int64>(state->sCharStateBase.dwConditionFlag) : 0u,
+                avatar ? static_cast<unsigned int>(avatar->IsAirMode() != FALSE) : 0u,
+                behavior ? static_cast<unsigned int>(behavior->GetMoveStuff()->byFormFlag == NTL_MOVE_FLAG_SWIM) : 0u,
+                behavior ? static_cast<unsigned int>(behavior->GetJumpStuff()->eState) : 255u,
+                fsm ? static_cast<unsigned int>(fsm->GetStateId()) : static_cast<unsigned int>(-1));
+            ::OutputDebugStringA(line);
+        }
+        catch (...) { /* Diagnostics cannot change the native rejection path. */ }
+    }
+}
