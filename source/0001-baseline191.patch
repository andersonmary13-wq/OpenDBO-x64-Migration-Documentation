+VOID CWorldMapGui::LoadNpcSearch(RwBool syncSelectors)
+{
+    MapTrace24NpcScope npcTrace24;
+    if (syncSelectors) SyncNpcMapSelectors();
+    if (!m_pcbbSearchNpc || m_uiRenderingWorldID == INVALID_WORLDID ||
+        m_uiNpcAreaWorld != m_uiRenderingWorldID || m_uiNpcAreaCode == INVALID_TBLIDX ||
+        NpcAreaZone25(m_uiNpcAreaCode) != m_uiRenderingZoneID ||
+        !_finite(m_v2MapPos.x) || !_finite(m_v2MapPos.y) || !_finite(m_fMapScale) || m_fMapScale <= 0.f)
+    { ClearNpcSearch(); return; }
+    if (!EnsureNpcAreaIndex(m_uiRenderingWorldID)) { ClearNpcSearch(); return; }
+    const sNPC_WORLD_INDEX& index = m_mapNpcWorldIndex.find(m_uiRenderingWorldID)->second;
+    if (m_bNpcSearchCacheValid && m_uiNpcSearchWorld == m_uiRenderingWorldID &&
+        m_uiNpcSearchArea == m_uiNpcAreaCode && m_uiNpcSearchRevision == index.fields.size() &&
+        m_uiNpcSearchZone == m_uiRenderingZoneID && m_byNpcSearchMode == m_byMapMode &&
+        m_v2NpcSearchMapPos.x == m_v2MapPos.x && m_v2NpcSearchMapPos.y == m_v2MapPos.y && m_fNpcSearchScale == m_fMapScale)
+    {
+        MapTrace24NpcResult(1, m_mapNpcSearch.size()); RefreshNpcSearchChoices(); return;
+    }
+    ClearNpcSearch();
+    const ULONGLONG namesStarted = MapTrace24Tick();
+    CNPCTable* npcs = API_GetTableContainer()->GetNpcTable();
+    CTextTable* names = API_GetTableContainer()->GetTextAllTable()->GetNPCTbl();
+    if (!npcs || !names) return;
+    const std::pair<TBLIDX, TBLIDX> key(m_uiRenderingWorldID, m_uiNpcAreaCode);
+    std::map<std::pair<TBLIDX, TBLIDX>, sNPC_AREA_NAMES>::iterator named = m_mapNpcAreaNames.find(key);
+    if (named == m_mapNpcAreaNames.end() || named->second.fieldCount != index.fields.size())
+    {
+        sNPC_AREA_NAMES cache; cache.fieldCount = index.fields.size();
+        std::map<TBLIDX, std::vector<sNPC_AREA_SPAWN> >::const_iterator area = index.areas.find(m_uiNpcAreaCode);
+        if (area != index.areas.end())
+        {
+            for (size_t i = 0; i < area->second.size(); ++i)
+            {
+                const sNPC_AREA_SPAWN& spawn = area->second[i];
+                if (cache.entries.find(spawn.npc) != cache.entries.end()) continue;
+                sNPC_TBLDAT* npc = reinterpret_cast<sNPC_TBLDAT*>(npcs->FindData(spawn.npc));
+                sNPC_SEARCH_ENTRY entry; entry.vPos = spawn.pos;
+                if (!npc || !names->GetText(npc->Name, &entry.wstrName) ||
+                    entry.wstrName.find_first_not_of(L" \t\r\n") == std::wstring::npos) continue;
+                const bool service = npc->byJob < NPC_JOB_COUNT && npc->byJob != NPC_JOB_TALKER &&
+                    npc->byJob != NPC_JOB_GUARD && npc->byJob != NPC_JOB_SUMMON_PET && npc->byJob != NPC_JOB_BUS;
+                entry.bQuestOnly = IsGenericNpcSearchName(entry.wstrName) && !service;
+                const WCHAR* job = Logic_GetNPCJobName(npc->byJob);
+                if (job && job[0]) { entry.wstrName += L" ("; entry.wstrName += job; entry.wstrName += L")"; }
+                cache.entries.insert(std::make_pair(spawn.npc, entry));
+            }
+        }
+        typedef std::map<TBLIDX, sNPC_SEARCH_ENTRY>::const_iterator NPCIT;
+        std::vector<NPCIT> sorted;
+        for (NPCIT it = cache.entries.begin(); it != cache.entries.end(); ++it) sorted.push_back(it);
+        std::sort(sorted.begin(), sorted.end(), [](NPCIT a, NPCIT b)
+        { return a->second.wstrName == b->second.wstrName ? a->first < b->first : a->second.wstrName < b->second.wstrName; });
+        for (size_t i = 0; i < sorted.size(); ++i) cache.order.push_back(sorted[i]->first);
+        m_mapNpcAreaNames[key] = cache;
+        named = m_mapNpcAreaNames.find(key);
+    }
+    // Project only this area's cached values; no region-wide name folding or GUI adds.
+    for (size_t i = 0; i < named->second.order.size(); ++i)
+    {
+        const TBLIDX id = named->second.order[i];
+        const sNPC_SEARCH_ENTRY& entry = named->second.entries.find(id)->second;
+        RwInt32 x, y;
+        if (ProjectNpcSearchPosition(entry.vPos, x, y))
+        { m_mapNpcSearch.insert(std::make_pair(id, entry)); m_vecNpcSearchOrder.push_back(id); }
+    }
+    m_uiNpcSearchWorld = m_uiRenderingWorldID; m_uiNpcSearchZone = m_uiRenderingZoneID;
+    m_uiNpcSearchArea = m_uiNpcAreaCode; m_uiNpcSearchRevision = index.fields.size();
+    m_byNpcSearchMode = m_byMapMode; m_v2NpcSearchMapPos = m_v2MapPos; m_fNpcSearchScale = m_fMapScale;
+    m_bNpcSearchCacheValid = TRUE;
+    if (g_mapTrace24) g_mapTrace24->namesMs += ::GetTickCount64() - namesStarted;
+    MapTrace24NpcResult(0, m_mapNpcSearch.size()); RefreshNpcSearchChoices();
+}
