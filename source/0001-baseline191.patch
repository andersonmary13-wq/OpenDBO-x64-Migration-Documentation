diff --git a/DboShared/NtlShared2/NtlInventorySort.h b/DboShared/NtlShared2/NtlInventorySort.h
new file mode 100644
--- /dev/null
+++ b/DboShared/NtlShared2/NtlInventorySort.h
@@ -0,0 +1,123 @@
+#pragma once
+
+#include "NtlSharedType.h"
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <set>
+#include <tuple>
+#include <vector>
+
+// Local coordinated-build protocol. Existing inventory sort packets are intact.
+namespace NtlInventorySort
+{
+    constexpr std::size_t MaxItems = 160;
+    constexpr std::size_t MaxContainers = 5;
+    enum Scope : std::uint8_t { Bags = 0, PersonalBank = 2 };
+    enum Status : std::uint8_t { Ok = 0, Invalid = 1, Busy = 2, PersistenceFailed = 3, PersistenceUnknown = 4 };
+
+#pragma pack(push, 1)
+    struct Cell
+    {
+        std::uint8_t place;
+        std::uint8_t pos;
+        bool operator==(const Cell& other) const { return place == other.place && pos == other.pos; }
+        bool operator<(const Cell& other) const { return std::tie(place, pos) < std::tie(other.place, other.pos); }
+    };
+    struct Move
+    {
+        ITEMID itemId;
+        HOBJECT handle;
+        TBLIDX tableId;
+        std::uint8_t count;
+        std::uint8_t type;
+        std::uint8_t rank;
+        std::uint8_t grade;
+        Cell from;
+        Cell to;
+    };
+    struct ClientMove
+    {
+        HOBJECT handle;
+        Cell from;
+        Cell to;
+    };
+#pragma pack(pop)
+    static_assert(sizeof(Cell) == 2, "sort cell wire layout");
+    static_assert(sizeof(Move) == 24, "sort move wire layout");
+    static_assert(sizeof(ClientMove) == 8, "sort client move wire layout");
+
+    struct Container
+    {
+        std::uint8_t place;
+        std::uint8_t capacity;
+        bool available;
+    };
+    struct Item
+    {
+        ITEMID itemId;
+        HOBJECT handle;
+        TBLIDX tableId;
+        std::uint8_t count;
+        std::uint8_t type;
+        std::uint8_t rank;
+        std::uint8_t grade;
+        Cell position;
+        bool available;
+    };
+
+    inline bool ValidContainer(Scope scope, const Container& container)
+    {
+        // Native eCONTAINER_TYPE: BAG1..5=1..5, BANK1..3=8..10.
+        // BANK4 (shared account) and guild banks are separate ownership domains.
+        return container.available && container.capacity > 0
+            && (scope == Bags ? container.place >= 1 && container.place <= 5 && container.capacity <= 32
+                : scope == PersonalBank && container.place >= 8 && container.place <= 10 && container.capacity <= 16);
+    }
+
+    // Pure planner: never edits an item, count, option, equipped slot or input.
+    // Callers validate ownership/locks/reservations, then pass availability.
+    inline bool BuildPlan(Scope scope, const std::vector<Container>& containers,
+        const std::vector<Item>& items, std::vector<Move>& output)
+    {
+        output.clear();
+        if ((scope != Bags && scope != PersonalBank) || containers.empty() || containers.size() > MaxContainers
+            || (scope == PersonalBank && containers.size() != 1) || items.size() > MaxItems) return false;
+        std::set<std::uint8_t> places;
+        std::vector<Cell> cells;
+        for (const auto& container : containers)
+        {
+            if (!ValidContainer(scope, container) || !places.insert(container.place).second) return false;
+            for (std::uint8_t pos = 0; pos < container.capacity; ++pos) cells.push_back({container.place, pos});
+        }
+        if (cells.size() > MaxItems || items.size() > cells.size()) return false;
+        std::sort(cells.begin(), cells.end());
+        std::set<ITEMID> ids;
+        std::set<HOBJECT> handles;
+        std::set<Cell> occupied;
+        std::vector<Item> ordered(items);
+        for (const auto& item : ordered)
+        {
+            if (!item.available || item.itemId == 0 || item.itemId == INVALID_ITEMID || item.itemId == UINT64_MAX
+                || item.handle == INVALID_HOBJECT || item.tableId == INVALID_TBLIDX || item.count == 0
+                || !ids.insert(item.itemId).second || !handles.insert(item.handle).second
+                || !occupied.insert(item.position).second
+                || !std::binary_search(cells.begin(), cells.end(), item.position)) return false;
+        }
+        std::sort(ordered.begin(), ordered.end(), [](const Item& a, const Item& b) {
+            if (a.type != b.type) return a.type < b.type;
+            if (a.tableId != b.tableId) return a.tableId < b.tableId;
+            if (a.rank != b.rank) return a.rank > b.rank;
+            if (a.grade != b.grade) return a.grade > b.grade;
+            return a.itemId < b.itemId;
+        });
+        output.reserve(ordered.size());
+        for (std::size_t i = 0; i < ordered.size(); ++i)
+        {
+            const auto& item = ordered[i];
+            output.push_back({item.itemId, item.handle, item.tableId, item.count, item.type, item.rank,
+                item.grade, item.position, cells[i]});
+        }
+        return true;
+    }
+}
diff --git a/DboShared/NtlShared2/NtlInventoryStackSort.h b/DboShared/NtlShared2/NtlInventoryStackSort.h
new file mode 100644
--- /dev/null
+++ b/DboShared/NtlShared2/NtlInventoryStackSort.h
@@ -0,0 +1,182 @@
+#pragma once
+
+#include "NtlInventorySort.h"
+#include "NtlItem.h"
+#include <map>
+
+// V2 is deliberately separate: V1 clients keep their permutation-only contract.
+namespace NtlInventoryStackSort
+{
+    using NtlInventorySort::Cell;
+    using NtlInventorySort::Container;
+    using NtlInventorySort::Scope;
+    using NtlInventorySort::Status;
+    using NtlInventorySort::Bags;
+    using NtlInventorySort::PersonalBank;
+    using NtlInventorySort::Ok;
+    using NtlInventorySort::Invalid;
+    using NtlInventorySort::Busy;
+    using NtlInventorySort::PersistenceFailed;
+    using NtlInventorySort::PersistenceUnknown;
+    constexpr std::size_t MaxItems = NtlInventorySort::MaxItems;
+
+#pragma pack(push, 1)
+    struct Move
+    {
+        ITEMID itemId;
+        HOBJECT handle;
+        TBLIDX tableId;
+        std::uint8_t count; // expected before count
+        std::uint8_t rank;
+        std::uint8_t grade;
+        Cell from;
+        Cell to; // {255,255} only for a fully consumed stack
+        std::uint8_t afterCount;
+        std::uint8_t maxStack;
+    };
+    struct ClientMove
+    {
+        HOBJECT handle;
+        Cell from;
+        Cell to;
+        std::uint8_t beforeCount;
+        std::uint8_t afterCount;
+    };
+#pragma pack(pop)
+    static_assert(sizeof(Move) == 25, "stack sort move wire layout");
+    static_assert(sizeof(ClientMove) == 10, "stack sort client move wire layout");
+
+    struct Item
+    {
+        NtlInventorySort::Item value;
+        std::uint8_t maxStack;
+        sITEM_DATA metadata;
+    };
+
+    inline bool SameStackMetadata(const sITEM_DATA& a, const sITEM_DATA& b)
+    {
+        if (a.charId != b.charId || a.itemNo != b.itemNo || a.byRank != b.byRank
+            || a.byCurrentDurability != b.byCurrentDurability || a.bNeedToIdentify != b.bNeedToIdentify
+            || a.byGrade != b.byGrade || a.byBattleAttribute != b.byBattleAttribute
+            || a.byRestrictState != b.byRestrictState || a.byDurationType != b.byDurationType
+            || a.nUseStartTime != b.nUseStartTime || a.nUseEndTime != b.nUseEndTime) return false;
+        // Compare the bounded name semantically, never uninitialized trailing bytes.
+        for (std::size_t i = 0; i < NTL_MAX_SIZE_CHAR_NAME + 1; ++i)
+        {
+            if (a.awchMaker[i] != b.awchMaker[i]) return false;
+            if (a.awchMaker[i] == 0) break;
+        }
+        for (std::size_t i = 0; i < NTL_MAX_OPTION_IN_ITEM; ++i)
+            if (a.sOptionSet.aOptionTblidx[i] != b.sOptionSet.aOptionTblidx[i]) return false;
+        for (std::size_t i = 0; i < NTL_MAX_RANDOM_OPTION_IN_ITEM; ++i)
+            if (a.sOptionSet.aRandomOption[i].wOptionIndex != b.sOptionSet.aRandomOption[i].wOptionIndex
+                || a.sOptionSet.aRandomOption[i].optionValue != b.sOptionSet.aRandomOption[i].optionValue) return false;
+        return true;
+    }
+
+    inline bool InScope(Scope scope, BYTE bankIndex, Cell cell)
+    {
+        return scope == Bags ? cell.place >= 1 && cell.place <= 5 && cell.pos < 32
+            : scope == PersonalBank && bankIndex < 3 && cell.place == 8 + bankIndex && cell.pos < 16;
+    }
+
+    // Query has no item table loader: maxStack comes from the authoritative Game
+    // table. Independently verify every identity, cell and semantic-class total.
+    inline bool ValidatePlan(Scope scope, BYTE bankIndex, const std::vector<sITEM_DATA>& snapshot,
+        const std::vector<Move>& moves)
+    {
+        if ((scope != Bags && scope != PersonalBank) || (scope == PersonalBank && bankIndex >= 3)
+            || snapshot.size() != moves.size() || moves.size() > MaxItems) return false;
+        std::map<ITEMID, const sITEM_DATA*> expected;
+        std::set<Cell> sources, targets;
+        for (const auto& data : snapshot)
+            if (data.itemId == 0 || data.itemId == INVALID_ITEMID || data.itemId == UINT64_MAX
+                || !InScope(scope, bankIndex, {data.byPlace, data.byPosition}) || data.byStackcount == 0
+                || !expected.emplace(data.itemId, &data).second
+                || !sources.insert({data.byPlace, data.byPosition}).second) return false;
+        std::set<ITEMID> ids;
+        std::set<HOBJECT> handles;
+        for (const auto& move : moves)
+        {
+            const auto found = expected.find(move.itemId);
+            if (found == expected.end() || !ids.insert(move.itemId).second || move.handle == INVALID_HOBJECT
+                || !handles.insert(move.handle).second || move.maxStack == 0 || move.count > move.maxStack
+                || move.afterCount > move.maxStack) return false;
+            const auto& data = *found->second;
+            if (data.itemNo != move.tableId || data.byStackcount != move.count || data.byRank != move.rank
+                || data.byGrade != move.grade || data.byPlace != move.from.place || data.byPosition != move.from.pos)
+                return false;
+            if (move.afterCount == 0)
+            {
+                if (!(move.to == Cell{255, 255})) return false;
+            }
+            else if (!InScope(scope, bankIndex, move.to) || !targets.insert(move.to).second) return false;
+        }
+        for (std::size_t i = 0; i < moves.size(); ++i)
+        {
+            unsigned before = 0, after = 0;
+            const auto& key = *expected.find(moves[i].itemId)->second;
+            for (const auto& move : moves)
+            {
+                const auto& data = *expected.find(move.itemId)->second;
+                if (!SameStackMetadata(key, data)) continue;
+                if (move.maxStack != moves[i].maxStack) return false;
+                before += move.count;
+                after += move.afterCount;
+            }
+            if (before != after) return false;
+        }
+        return true;
+    }
+
+    inline bool BuildPlan(Scope scope, const std::vector<Container>& containers,
+        const std::vector<Item>& items, std::vector<Move>& output)
+    {
+        output.clear();
+        std::vector<NtlInventorySort::Item> base;
+        std::map<ITEMID, const Item*> byId;
+        std::vector<sITEM_DATA> snapshot;
+        for (const auto& item : items)
+        {
+            const auto& value = item.value;
+            const auto& data = item.metadata;
+            if (item.maxStack == 0 || value.count > item.maxStack || data.itemId != value.itemId
+                || data.itemNo != value.tableId || data.byStackcount != value.count || data.byRank != value.rank
+                || data.byGrade != value.grade || data.byPlace != value.position.place
+                || data.byPosition != value.position.pos) return false;
+            base.push_back(value);
+            byId.emplace(value.itemId, &item);
+            snapshot.push_back(data);
+        }
+        std::vector<NtlInventorySort::Move> ordered;
+        if (!NtlInventorySort::BuildPlan(scope, containers, base, ordered)) return false;
+        std::vector<Move> plan;
+        for (const auto& entry : ordered)
+        {
+            const auto& item = *byId.find(entry.itemId)->second;
+            Move move = {entry.itemId, entry.handle, entry.tableId, entry.count, entry.rank,
+                entry.grade, entry.from, {255, 255}, entry.count, item.maxStack};
+            for (auto& receiver : plan)
+            {
+                if (move.afterCount == 0) break;
+                if (receiver.afterCount == 0 || receiver.afterCount >= receiver.maxStack
+                    || receiver.maxStack != move.maxStack
+                    || !SameStackMetadata(byId.find(receiver.itemId)->second->metadata, item.metadata)) continue;
+                const unsigned transfer = (std::min)(unsigned(move.afterCount), unsigned(receiver.maxStack - receiver.afterCount));
+                receiver.afterCount += static_cast<BYTE>(transfer);
+                move.afterCount -= static_cast<BYTE>(transfer);
+            }
+            plan.push_back(move);
+        }
+        std::vector<Cell> cells;
+        for (const auto& container : containers)
+            for (BYTE pos = 0; pos < container.capacity; ++pos) cells.push_back({container.place, pos});
+        std::sort(cells.begin(), cells.end());
+        std::size_t target = 0;
+        for (auto& move : plan) if (move.afterCount) move.to = cells[target++];
+        const BYTE bankIndex = scope == PersonalBank ? containers.front().place - 8 : 0;
+        if (!ValidatePlan(scope, bankIndex, snapshot, plan)) return false;
+        output.swap(plan);
+        return true;
+    }
+}
