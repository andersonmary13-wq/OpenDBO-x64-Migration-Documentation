+RwBool CWorldMapGui::IsNpcSearchQuestRelevant(TBLIDX npc)
+{
+	CNtlSobAvatar* pAvatar = GetNtlSLGlobal()->GetSobAvatar();
+	if (!pAvatar) return FALSE;
+	CNtlOtherParam* pOther = pAvatar->GetOtherParam();
+	if (pOther && pOther->IsExistNextQuest_of_NPC(npc)) return TRUE;
+	CDboTSCQAgency* pAgency = pAvatar->GetQuestAgency();
+	return pAgency && pAgency->HasEventNPCInProgressQuest(npc);
+}
