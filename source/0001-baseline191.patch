+	if (!m_bMouseBackgroundCapture || ::GetCapture() != window ||
+		::IsIconic(window) || ::GetForegroundWindow() != window)
+	{
+		m_bMouseBackgroundCapture = FALSE;
+		CInputHandler::GetInstance()->CancelMouseInput();
+		if (::GetCapture() == window)
+			::ReleaseCapture();
+		return false;
+	}
+	return true;
+}
