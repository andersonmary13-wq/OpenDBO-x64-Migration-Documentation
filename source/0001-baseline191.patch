+namespace
+{
+    bool LocalMascotGameplayReady()
+    {
+        if (!GetGameStageState() || !GetGameStageState()->IsState(GAME_STATE_NONE) || !GetDboGlobal())
+            return false;
+        CStageManager* manager = CStageManager::GetInstance();
+        CNtlStage* stage = manager ? manager->GetActiveStage() : NULL;
+        SConnectData* connections = GetDboGlobal()->GetConnectData();
+        if (!stage || strcmp(stage->GetName(), GAME_STAGE_NAME) != 0 || !connections)
+            return false;
+        return connections->sGameCon.byConnState == SConnectAtomic::SOCKET_STATE_CONNECT &&
+            connections->sGameCon.hSocket != INVALID_HSERVER &&
+            static_cast<CGameStage*>(stage)->IsGameplayReady();
+    }
+
+    std::string LocalMascotPreference(BYTE index, TBLIDX table)
+    {
+        std::ostringstream out;
+        out.imbue(std::locale::classic());
+        out << "v1_" << static_cast<unsigned>(index) << '_' << table;
+        return out.str();
+    }
+
+    bool ReadLocalMascotPreference(const std::string& value, BYTE& index, TBLIDX& table)
+    {
+        if (value.size() > 48 || value.compare(0, 3, "v1_") != 0 ||
+            value.substr(3).find_first_not_of("0123456789_") != std::string::npos)
+            return false;
+        unsigned long long slot, id;
+        char separator;
+        std::istringstream in(value.substr(3));
+        in.imbue(std::locale::classic());
+        if (!(in >> slot >> separator >> id) || separator != '_' || in.peek() != std::char_traits<char>::eof() ||
+            slot >= INVALID_BYTE || id == 0 || id >= INVALID_TBLIDX)
+            return false;
+        if (LocalMascotPreference(static_cast<BYTE>(slot), static_cast<TBLIDX>(id)) != value)
+            return false;
+        index = static_cast<BYTE>(slot);
+        table = static_cast<TBLIDX>(id);
+        return true;
+    }
+}
