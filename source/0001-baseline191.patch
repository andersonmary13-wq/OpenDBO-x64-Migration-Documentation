+
+// Native character options: a local preference, not a server-side summon flag.
+bool CMascotGui::BindPreferenceContext()
+{
+    CNtlSobAvatar* avatar = GetNtlSLGlobal()->GetSobAvatar();
+    const unsigned long long epoch = NtlCharacterPreferenceEpoch();
+    if (!avatar || !epoch || !GetNtlSobManager()->GetActive() || !avatar->IsAvatarReady() || !LocalMascotGameplayReady())
+        return false;
+    if (m_preferenceEpoch != epoch || m_preferenceCharacter != avatar->GetCharID() ||
+        m_preferenceAvatar != avatar->GetSerialID())
+    {
+        m_preferenceEpoch = epoch;
+        m_preferenceCharacter = avatar->GetCharID();
+        m_preferenceAvatar = avatar->GetSerialID();
+        m_preferenceSummonRequest = INVALID_BYTE;
+        m_preferenceDismissRequest = INVALID_BYTE;
+    }
+    return true;
+}
+
+bool CMascotGui::MatchesPreferenceContext() const
+{
+    CNtlSobAvatar* avatar = GetNtlSLGlobal()->GetSobAvatar();
+    return avatar && GetNtlSobManager()->GetActive() && m_preferenceEpoch && m_preferenceEpoch == NtlCharacterPreferenceEpoch() &&
+        m_preferenceCharacter == avatar->GetCharID() && m_preferenceAvatar == avatar->GetSerialID() &&
+        avatar->IsAvatarReady() && LocalMascotGameplayReady();
+}
+
+void CMascotGui::TryRestorePreference()
+{
+    if (!BindPreferenceContext()) return;
+    SMascotInfo* info = GetNtlSLGlobal()->GetAvatarMascotInfo();
+    // The native list is delivered before the stage becomes idle. An empty list has nothing to restore.
+    if (!info || !info->wCount || !NtlMarkMascotPreferenceAttempt(m_preferenceEpoch)) return;
+    if (info->bySummonIndex != INVALID_BYTE) return;
+    BYTE index;
+    TBLIDX table;
+    if (!ReadLocalMascotPreference(GetNtlStorageManager()->GetStringData(dSTORAGE_CHARACTER_MASCOT_RESTORE), index, table)) return;
+    sMASCOT_DATA_EX* selected = info->Find(index); // byIndex is not an array offset
+    if (!selected || selected->tblidx != table) return;
+    m_preferenceSummonRequest = index;
+    m_preferenceSummonTable = table;
+    // No retry or saved-state mutation on send failure. Only a matching native success event commits the preference.
+    GetDboGlobal()->GetGamePacketGenerator()->SendSummonMascot(index);
+}
+
+void CMascotGui::ConfirmPreference(RWS::CMsg& msg, BYTE index)
+{
+    if (!MatchesPreferenceContext()) return;
+    SMascotInfo* info = GetNtlSLGlobal()->GetAvatarMascotInfo();
+    sMASCOT_DATA_EX* selected = info->Find(index);
+    if (msg.Id == g_EventMascotSummon)
+    {
+        if (index != m_preferenceSummonRequest || info->bySummonIndex != index ||
+            !selected || selected->tblidx != m_preferenceSummonTable) return;
+        m_preferenceSummonRequest = INVALID_BYTE;
+        if (!GetNtlStorageManager()->SetData(dSTORAGE_CHARACTER_MASCOT_RESTORE, LocalMascotPreference(index, selected->tblidx))) return;
+    }
+    else
+    {
+        BYTE savedIndex;
+        TBLIDX savedTable;
+        if (!ReadLocalMascotPreference(GetNtlStorageManager()->GetStringData(dSTORAGE_CHARACTER_MASCOT_RESTORE), savedIndex, savedTable) || savedIndex != index) return;
+        const bool dismissed = msg.Id == g_EventMascotUnSummon && index == m_preferenceDismissRequest &&
+            info->bySummonIndex == INVALID_BYTE && selected && selected->tblidx == savedTable;
+        const bool deleted = msg.Id == g_EventMascotDelete && !selected;
+        if (!dismissed && !deleted) return;
+        m_preferenceDismissRequest = INVALID_BYTE;
+        if (!GetNtlStorageManager()->SetData(dSTORAGE_CHARACTER_MASCOT_RESTORE, "none")) return;
+    }
+    Logic_SaveCharacterOption();
+}
