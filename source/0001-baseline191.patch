diff --git a/NtlLib/Server/servercommon/ShutdownWorkGate.h b/NtlLib/Server/servercommon/ShutdownWorkGate.h
new file mode 100644
--- /dev/null
+++ b/NtlLib/Server/servercommon/ShutdownWorkGate.h
@@ -0,0 +1,52 @@
+#pragma once
+
+#include <atomic>
+#include <mutex>
+#include <cstdint>
+#include <cstdio>
+
+// App ticks, callbacks and network handlers use the same gate. Once the app
+// has stopped producing gameplay work, only the barrier ACK bypasses this gate.
+struct CShutdownWorkGate
+{
+	class Guard
+	{
+	public:
+		explicit Guard(CShutdownWorkGate& state) : m_state(state), m_lock(state.mutex) {}
+		bool IsAllowed() const { return !m_state.quiesced.load(); }
+	private:
+		CShutdownWorkGate& m_state;
+		std::unique_lock<std::mutex> m_lock;
+	};
+
+	void Acknowledge(const char* service, std::uint64_t ackToken, bool success,
+		std::uint64_t commits, std::uint64_t failures)
+	{
+		if (!requested.load() || ackToken != token.load()) return;
+		if (success && failures == 0)
+		{
+			printf("SHUTDOWN_QUERY_ACK service=%s token=%llu commits=%llu failures=0\n", service, ackToken, commits);
+			fflush(stdout);
+			ready.store(true);
+		}
+		else
+		{
+			printf("SHUTDOWN_QUERY_BARRIER_FAILED service=%s token=%llu commits=%llu failures=%llu\n", service, ackToken, commits, failures);
+			fflush(stdout);
+		}
+	}
+
+	void PrintStatus(const char* service) const
+	{
+		printf("SHUTDOWN_QUERY_STATUS service=%s requested=%u quiesced=%u token=%llu ack=%u\n", service,
+			(unsigned)requested.load(), (unsigned)quiesced.load(), token.load(), (unsigned)ready.load());
+		fflush(stdout);
+	}
+
+	std::mutex mutex;
+	std::atomic<bool> requested{false};
+	std::atomic<bool> quiesced{false};
+	std::atomic<bool> ready{false};
+	std::atomic<std::uint64_t> token{0};
+	bool sent = false; // App thread only; Guard is held while sending the barrier.
+};
