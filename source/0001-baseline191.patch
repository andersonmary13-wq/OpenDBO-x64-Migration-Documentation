+TBLIDX CWorldMapGui::GetNpcSelectorParent(TBLIDX id)
+{
+    sWORLD_MAP_TBLDAT* row = GetNpcSelectorMap(id);
+    if (!row || row->dwComboBoxType == 1) return INVALID_TBLIDX;
+    sWORLD_MAP_TBLDAT* linked = GetNpcSelectorMap(row->dwLinkMapIdx, row->dwComboBoxType - 1);
+    if (linked) return linked->tblidx;
+    // Only unlinked regions may inherit an overview with the SAME native world.
+    if (row->dwComboBoxType != 2 || row->dwLinkMapIdx != INVALID_TBLIDX) return INVALID_TBLIDX;
+    TBLIDX result = INVALID_TBLIDX;
+    CWorldMapTable* table = API_GetTableContainer()->GetWorldMapTable();
+    for (CTable::TABLEIT it = table->Begin(); it != table->End(); ++it)
+    {
+        sWORLD_MAP_TBLDAT* parent = GetNpcSelectorMap(it->first, 1);
+        if (parent && parent->World_Tblidx == row->World_Tblidx)
+        {
+            if (result != INVALID_TBLIDX) return INVALID_TBLIDX; // ambiguous hierarchy
+            result = parent->tblidx;
+        }
+    }
+    return result;
+}
