+void Database::Quarantine()
+{
+    if (!m_quarantined.exchange(true))
+    {
+        RecordFailure();
+        // No SQL, account data or connection credentials in this marker.
+        printf("DB_QUARANTINED reason=atomic_outcome_unknown restart_and_reconcile_required=1\n");
+        fflush(stdout);
+        s_cond.notify_all();
+    }
+}
