+static DWORD ParseLegendaryDropMultiplier27(const char* text)
+{
+    if (!text || strlen(text) > 64) return 1;
+    const char* cursor = text;
+    while (*cursor == ' ' || *cursor == '\t' || *cursor == '\r' || *cursor == '\n') ++cursor;
+    DWORD value = 0;
+    bool any = false;
+    while (*cursor >= '0' && *cursor <= '9')
+    {
+        any = true;
+        const DWORD digit = static_cast<DWORD>(*cursor - '0');
+        if (value > (1000 - digit) / 10) return 1;
+        value = value * 10 + digit;
+        ++cursor;
+    }
+    while (*cursor == ' ' || *cursor == '\t' || *cursor == '\r' || *cursor == '\n') ++cursor;
+    return any && *cursor == '\0' ? value : 1;
+}
