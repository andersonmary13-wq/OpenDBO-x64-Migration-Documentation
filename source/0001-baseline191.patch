+RwBool CWorldMapGui::EnsureNpcAreaIndex(TBLIDX world)
+{
+    sWORLD_TBLDAT* resource = reinterpret_cast<sWORLD_TBLDAT*>(API_GetTableContainer()->GetWorldTable()->FindData(world));
+    CSpawnTable* spawns = API_GetTableContainer()->GetNpcSpawnTable(world);
+    if (!resource || !spawns || !NpcAreaProject25(resource->szName)) return FALSE;
+    std::map<TBLIDX, sNPC_WORLD_INDEX>::iterator cached = m_mapNpcWorldIndex.find(world);
+    if (cached != m_mapNpcWorldIndex.end() && cached->second.project == resource->szName && cached->second.complete) return TRUE;
+    if (cached != m_mapNpcWorldIndex.end() && cached->second.project != resource->szName)
+    {
+        for (std::map<std::pair<TBLIDX, TBLIDX>, sNPC_AREA_NAMES>::iterator it = m_mapNpcAreaNames.begin(); it != m_mapNpcAreaNames.end();)
+            if (it->first.first == world) m_mapNpcAreaNames.erase(it++); else ++it;
+        m_bNpcSearchCacheValid = FALSE;
+    }
+    const ULONGLONG indexStarted = MapTrace24Tick();
+    sNPC_WORLD_INDEX index;
+    if (cached != m_mapNpcWorldIndex.end() && cached->second.project == resource->szName) index = cached->second;
+    index.project = resource->szName; index.complete = TRUE;
+    NpcAreaFileReader25 reader(dGET_WORLD_PARAM()->CurWorkingFolderName);
+    const std::string prefix = std::string("world\\") + resource->szName + "\\";
+    unsigned char gwp[82]; int fieldSize = 0, fieldCount = 0, half = 0, minimum = 0, maximum = 0;
+    if (!reader.Read(prefix + "#######.gwp", gwp, sizeof(gwp)) || !NpcAreaGrid25(gwp, fieldSize, fieldCount, half, minimum, maximum)) return FALSE;
+    CNPCTable* npcs = API_GetTableContainer()->GetNpcTable();
+    CNpcServerTable* servers = API_GetTableContainer()->GetNpcServerTable();
+    if (!npcs || !servers) return FALSE;
+    index.areas.clear();
+    for (CTable::TABLEIT it = spawns->Begin(); it != spawns->End(); ++it)
+    {
+        MapTrace24NpcRow();
+        sSPAWN_TBLDAT* spawn = reinterpret_cast<sSPAWN_TBLDAT*>(it->second);
+        if (!spawn || !spawn->bySpawn_Quantity || !spawn->mob_Tblidx || spawn->mob_Tblidx == INVALID_TBLIDX) continue;
+        sNPC_TBLDAT* npc = reinterpret_cast<sNPC_TBLDAT*>(npcs->FindData(spawn->mob_Tblidx));
+        sNPC_SERVER_TBLDAT* server = reinterpret_cast<sNPC_SERVER_TBLDAT*>(servers->FindData(spawn->mob_Tblidx));
+        if (!npc || !server || !npc->bValidity_Able || !server->bValidity_Able ||
+            npc->tblidx != spawn->mob_Tblidx || BIT_FLAG_TEST(npc->dwFunc_Bit_Flag, NPC_FUNC_FLAG_MOVING_NPC)) continue;
+        RwV3d pos = { spawn->vSpawn_Loc.x, spawn->vSpawn_Loc.y, spawn->vSpawn_Loc.z };
+        if (!_finite(pos.x) || !_finite(pos.y) || !_finite(pos.z) || pos.x < minimum || pos.x > maximum || pos.z < minimum || pos.z > maximum) continue;
+        const int field = CNtlMath::GetSafeIdx3D(pos, half, fieldSize, fieldCount);
+        if (field < 0 || field >= fieldCount * fieldCount) continue;
+        std::map<int, TBLIDX>::iterator known = index.fields.find(field);
+        if (known == index.fields.end())
+        {
+            char suffix[96], name[64];
+            sprintf_s(suffix, sizeof(suffix), "fields\\wfif%d\\wfpf%d", field, field);
+            if (!reader.Read(prefix + suffix, name, sizeof(name))) { index.complete = FALSE; continue; }
+            const TBLIDX code = NpcAreaName25(name);
+            if (code == INVALID_TBLIDX) { index.complete = FALSE; continue; }
+            known = index.fields.insert(std::make_pair(field, code)).first;
+        }
+        sNPC_AREA_SPAWN value; value.npc = spawn->mob_Tblidx; value.pos = pos;
+        index.areas[known->second].push_back(value);
+    }
+    if (g_mapTrace24) { g_mapTrace24->fieldReads += reader.reads; g_mapTrace24->readMs += reader.readMs; g_mapTrace24->indexMs += ::GetTickCount64() - indexStarted; }
+    m_mapNpcWorldIndex[world] = index;
+    return TRUE; // Known areas remain usable; failed fields are retried on next opening/selection.
+}
+
+TBLIDX CWorldMapGui::FirstNpcArea(TBLIDX world, TBLIDX zone)
+{
+    if (!EnsureNpcAreaIndex(world)) return INVALID_TBLIDX;
+    const sNPC_WORLD_INDEX& index = m_mapNpcWorldIndex.find(world)->second;
+    for (std::map<TBLIDX, std::vector<sNPC_AREA_SPAWN> >::const_iterator it = index.areas.begin(); it != index.areas.end(); ++it)
+        if (NpcAreaZone25(it->first) == zone && !GetNpcAreaLabel(it->first).empty()) return it->first;
+    return INVALID_TBLIDX;
+}
+
+VOID CWorldMapGui::SyncNpcMapSelectors()
+{
+    if (m_bUpdatingMapSelectors || !m_pcbbSearchWorld || !m_pcbbSearchZone || !m_pcbbSearchCity) return;
+    NpcSelectorGuard25 guard(m_bUpdatingMapSelectors);
+    m_vecNpcWorldChoices.clear(); m_vecNpcZoneChoices.clear(); m_vecNpcAreaChoices.clear();
+    m_pcbbSearchWorld->ClearAllItems(); m_pcbbSearchZone->ClearAllItems(); m_pcbbSearchCity->ClearAllItems();
+    sWORLD_MAP_TBLDAT* current = GetWorldMapTable(m_uiRenderingWorldID, m_uiRenderingZoneID);
+    TBLIDX region = current ? current->tblidx : INVALID_TBLIDX;
+    if (current && current->dwComboBoxType == 3) region = GetNpcSelectorParent(region);
+    TBLIDX overview = current && current->dwComboBoxType == 1 ? current->tblidx : GetNpcSelectorParent(region);
+    CWorldMapTable* table = API_GetTableContainer()->GetWorldMapTable();
+    int worldSelected = -1, zoneSelected = -1, areaSelected = -1;
+    for (CTable::TABLEIT it = table->Begin(); it != table->End(); ++it)
+    {
+        sWORLD_MAP_TBLDAT* row = GetNpcSelectorMap(it->first, 1);
+        if (!row) continue;
+        std::wstring label = GetNpcAreaLabel(row->Worldmap_Name);
+        if (label.empty()) continue;
+        if (row->tblidx == overview) worldSelected = static_cast<int>(m_vecNpcWorldChoices.size());
+        m_pcbbSearchWorld->AddItem(label.c_str(), row->tblidx); m_vecNpcWorldChoices.push_back(row->tblidx);
+    }
+    if (worldSelected >= 0)
+    {
+        for (CTable::TABLEIT it = table->Begin(); it != table->End(); ++it)
+        {
+            sWORLD_MAP_TBLDAT* row = GetNpcSelectorMap(it->first, 2);
+            if (!row || GetNpcSelectorParent(row->tblidx) != overview) continue;
+            std::wstring label = GetNpcAreaLabel(row->Worldmap_Name);
+            if (label.empty()) continue;
+            if (row->tblidx == region) zoneSelected = static_cast<int>(m_vecNpcZoneChoices.size());
+            m_pcbbSearchZone->AddItem(label.c_str(), row->tblidx); m_vecNpcZoneChoices.push_back(row->tblidx);
+        }
+    }
+    sWORLD_MAP_TBLDAT* parent = GetNpcSelectorMap(region, 2);
+    if (zoneSelected >= 0 && parent && EnsureNpcAreaIndex(parent->World_Tblidx))
+    {
+        const sNPC_WORLD_INDEX& index = m_mapNpcWorldIndex.find(parent->World_Tblidx)->second;
+        std::map<TBLIDX, std::vector<sNPC_AREA_SPAWN> >::const_iterator it = index.areas.begin();
+        for (; it != index.areas.end(); ++it)
+        {
+            if (NpcAreaZone25(it->first) != parent->Zone_Tblidx) continue;
+            std::wstring label = GetNpcAreaLabel(it->first); if (label.empty()) continue;
+            sNPC_AREA_CHOICE choice; choice.map = parent->tblidx; choice.area = it->first;
+            if (current && current->tblidx == choice.map && m_uiNpcAreaCode == choice.area)
+                areaSelected = static_cast<int>(m_vecNpcAreaChoices.size());
+            m_pcbbSearchCity->AddItem(label.c_str(), static_cast<DWORD>(m_vecNpcAreaChoices.size()));
+            m_vecNpcAreaChoices.push_back(choice);
+        }
+        // A live area with no NPC spawn must still be selectable (and show an empty NPC list).
+        if (current && current->tblidx == parent->tblidx && m_uiNpcAreaCode != INVALID_TBLIDX && areaSelected < 0 &&
+            NpcAreaZone25(m_uiNpcAreaCode) == parent->Zone_Tblidx)
+        {
+            std::wstring label = GetNpcAreaLabel(m_uiNpcAreaCode);
+            if (!label.empty())
+            {
+                sNPC_AREA_CHOICE choice; choice.map = parent->tblidx; choice.area = m_uiNpcAreaCode;
+                areaSelected = static_cast<int>(m_vecNpcAreaChoices.size());
+                m_pcbbSearchCity->AddItem(label.c_str(), static_cast<DWORD>(m_vecNpcAreaChoices.size()));
+                m_vecNpcAreaChoices.push_back(choice);
+            }
+        }
+        for (CTable::TABLEIT rowIt = table->Begin(); rowIt != table->End(); ++rowIt)
+        {
+            sWORLD_MAP_TBLDAT* row = GetNpcSelectorMap(rowIt->first, 3);
+            if (!row || GetNpcSelectorParent(row->tblidx) != region) continue;
+            std::wstring label = GetNpcAreaLabel(row->Worldmap_Name); if (label.empty()) continue;
+            // Native CITY texture identity stays distinct from a local field-area identity.
+            label += L" (map)";
+            sNPC_AREA_CHOICE choice; choice.map = row->tblidx;
+            choice.area = current && current->tblidx == row->tblidx ? m_uiNpcAreaCode : INVALID_TBLIDX;
+            if (current && current->tblidx == row->tblidx) areaSelected = static_cast<int>(m_vecNpcAreaChoices.size());
+            m_pcbbSearchCity->AddItem(label.c_str(), static_cast<DWORD>(m_vecNpcAreaChoices.size()));
+            m_vecNpcAreaChoices.push_back(choice);
+        }
+    }
+    m_pcbbSearchWorld->SelectItem(worldSelected); m_pcbbSearchZone->SelectItem(zoneSelected); m_pcbbSearchCity->SelectItem(areaSelected);
+    m_pcbbSearchWorld->Enable(!m_vecNpcWorldChoices.empty()); m_pcbbSearchZone->Enable(!m_vecNpcZoneChoices.empty());
+    m_pcbbSearchCity->Enable(!m_vecNpcAreaChoices.empty());
+    SetNpcSelectorTooltip26(m_pcbbSearchWorld, worldSelected >= 0 ? m_pcbbSearchWorld->GetItemText(worldSelected) : std::wstring());
+    SetNpcSelectorTooltip26(m_pcbbSearchZone, zoneSelected >= 0 ? m_pcbbSearchZone->GetItemText(zoneSelected) : std::wstring());
+    SetNpcSelectorTooltip26(m_pcbbSearchCity, areaSelected >= 0 ? m_pcbbSearchCity->GetItemText(areaSelected) : std::wstring());
+}
+
+RwBool CWorldMapGui::SelectNpcMap(TBLIDX id, TBLIDX area)
+{
+    if (m_bUpdatingMapSelectors || m_bSelectingNpcMap) return FALSE;
+    sWORLD_MAP_TBLDAT* row = GetNpcSelectorMap(id);
+    if (!row || (row->dwComboBoxType > 1 && GetNpcSelectorParent(id) == INVALID_TBLIDX)) { SyncNpcMapSelectors(); return FALSE; }
+    // A callback cannot smuggle an unrelated local-area code or orphaned map choice.
+    if (area != INVALID_TBLIDX && (row->dwComboBoxType == 1 || NpcAreaZone25(area) != row->Zone_Tblidx ||
+        GetNpcAreaLabel(area).empty())) { SyncNpcMapSelectors(); return FALSE; }
+    MapTrace24Scope navigationTrace25(true, row->World_Tblidx, row->Zone_Tblidx, row->byMapType, true);
+    const TBLIDX oldWorld = m_uiRenderingWorldID, oldZone = m_uiRenderingZoneID;
+    const TBLIDX oldArea = m_uiNpcAreaCode, oldAreaWorld = m_uiNpcAreaWorld;
+    const RwUInt8 oldMode = m_byMapMode; const RwBool oldChanged = m_bChangedMap_by_User;
+    NpcSelectorGuard25 guard(m_bSelectingNpcMap);
+    const bool sameMap = oldWorld == row->World_Tblidx && oldZone == row->Zone_Tblidx && oldMode == row->byMapType;
+    m_uiRenderingWorldID = row->World_Tblidx; m_uiRenderingZoneID = row->Zone_Tblidx; m_byMapMode = row->byMapType;
+    m_uiNpcAreaWorld = row->World_Tblidx;
+    m_uiNpcAreaCode = row->dwComboBoxType == 1 ? INVALID_TBLIDX : area;
+    if (m_uiNpcAreaCode != INVALID_TBLIDX && NpcAreaZone25(m_uiNpcAreaCode) != row->Zone_Tblidx) m_uiNpcAreaCode = INVALID_TBLIDX;
+    if (row->dwComboBoxType > 1 && m_uiNpcAreaCode == INVALID_TBLIDX) m_uiNpcAreaCode = FirstNpcArea(row->World_Tblidx, row->Zone_Tblidx);
+    m_bChangedMap_by_User = TRUE;
+    if (sameMap)
+    {
+        // Local areas share a regional texture: filtering must not reload its surfaces.
+        LoadNpcSearch(TRUE); return TRUE;
+    }
+    if (AnalysisAreaInfo()) return TRUE;
+    m_uiRenderingWorldID = oldWorld; m_uiRenderingZoneID = oldZone; m_byMapMode = oldMode;
+    m_uiNpcAreaCode = oldArea; m_uiNpcAreaWorld = oldAreaWorld; m_bChangedMap_by_User = oldChanged;
+    if (!AnalysisAreaInfo()) ClearNpcSearch();
+    SyncNpcMapSelectors();
+    return FALSE;
+}
