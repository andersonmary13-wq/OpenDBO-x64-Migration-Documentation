+void Database::PrintWorkStatus()
+{
+	DatabaseWorkStatus status = GetAllWorkStatus();
+	printf("DB_STATUS pending=%llu before=%llu inflight=%llu after=%llu callbacks=%llu commits=%llu failures=%llu\n",
+		status.pending, status.before, status.inflight, status.after, status.callbacks, status.commits, status.failures);
