+CNtlSobItem* CVehicleGui::Fuel_GetOwned(SERIAL_HANDLE handle, BYTE& place, BYTE& position)
+{
+    CNtlSobAvatar* avatar = GetNtlSLGlobal()->GetSobAvatar();
+    if (!avatar || handle == INVALID_SERIAL_ID) return NULL;
+    CNtlSob* object = GetNtlSobManager()->GetSobObject(handle);
+    if (!object || object->GetClassID() != SLCLASS_SLOT_ITEM || object->GetOwnerID() != avatar->GetSerialID()) return NULL;
+    CNtlSobItem* item = reinterpret_cast<CNtlSobItem*>(object);
+    CNtlSobItemAttr* attr = reinterpret_cast<CNtlSobItemAttr*>(item->GetSobAttr());
+    if (!attr || !attr->GetItemTbl() || attr->GetItemTbl()->byItem_Type != ITEM_TYPE_FUEL ||
+        attr->IsNeedToIdentify() || attr->IsExpired()) return NULL;
+    CNtlInventory* inventory = avatar->GetInventory();
+    for (int bagIndex = 0; bagIndex < NTL_MAX_BAGSLOT_COUNT; ++bagIndex)
+    {
+        CNtlSob* parent = GetNtlSobManager()->GetSobObject(inventory->GetBagItem(bagIndex));
+        if (!parent || parent->GetClassID() != SLCLASS_SLOT_ITEM) continue;
+        CNtlSobItem* bag = reinterpret_cast<CNtlSobItem*>(parent);
+        const int count = bag->GetChildNum();
+        if (count < 0 || count > NTL_MAX_BAG_ITEM_SLOT) continue;
+        for (int slot = 0; slot < count; ++slot)
+            if (bag->GetChildSerial(slot) == handle && item->GetParentItemSerial() == bag->GetSerialID() && item->GetItemSlotIdx() == slot)
+            {
+                place = static_cast<BYTE>(bagIndex + 1);
+                position = static_cast<BYTE>(slot);
+                return item;
+            }
+    }
+    return NULL;
+}
+
+bool CVehicleGui::Fuel_MatchesContext() const
+{
+    CNtlSobAvatar* avatar = GetNtlSLGlobal()->GetSobAvatar();
+    return avatar && GetNtlSobManager()->GetActive() && m_preferenceEpoch && m_preferenceEpoch == NtlCharacterPreferenceEpoch() &&
+        m_preferenceCharacter == avatar->GetCharID() && m_preferenceAvatar == avatar->GetSerialID() &&
+        m_preferenceVehicle == avatar->GetVehicleID() && Logic_IsVehicleDriver(avatar) &&
+        avatar->IsAvatarReady() && LocalFuelGameplayReady();
+}
+
+void CVehicleGui::Fuel_TryRestore()
+{
+    CNtlSobAvatar* avatar = GetNtlSLGlobal()->GetSobAvatar();
+    if (!avatar || !NtlCharacterPreferenceEpoch() || !GetNtlSobManager()->GetActive() || !avatar->IsAvatarReady() || !LocalFuelGameplayReady() ||
+        !Logic_IsVehicleDriver(avatar) || avatar->GetVehicleID() == INVALID_SERIAL_ID || !IsShow() ||
+        API_GetSLPacketLockManager()->IsLockType_withoutMessage(CNtlPacketLockManager::LT_ITEM)) return;
+    if (!NtlMarkFuelPreferenceAttempt(NtlCharacterPreferenceEpoch(), avatar->GetVehicleID())) return;
+    if (m_tFuel.FuelSlot.GetSerial() != INVALID_SERIAL_ID) return;
+    BYTE place, position;
+    SERIAL_HANDLE selected = avatar->GetOtherParam()->GetRegisterFuelItem();
+    if (Fuel_GetOwned(selected, place, position))
+    {
+        Fuel_CanRegister(selected); // same-avatar handle is an in-memory hint, never a saved identity
+        return;
+    }
+    const std::string saved = GetNtlStorageManager()->GetStringData(dSTORAGE_CHARACTER_FUEL_RESTORE);
+    if (!ReadLocalFuelPreference(saved)) return;
+    selected = INVALID_SERIAL_ID;
+    CNtlInventory* inventory = avatar->GetInventory();
+    for (int bagIndex = 0; bagIndex < NTL_MAX_BAGSLOT_COUNT; ++bagIndex)
+    {
+        CNtlSob* parent = GetNtlSobManager()->GetSobObject(inventory->GetBagItem(bagIndex));
+        if (!parent || parent->GetClassID() != SLCLASS_SLOT_ITEM) continue;
+        CNtlSobItem* bag = reinterpret_cast<CNtlSobItem*>(parent);
+        const int count = bag->GetChildNum();
+        if (count < 0 || count > NTL_MAX_BAG_ITEM_SLOT) continue;
+        for (int slot = 0; slot < count; ++slot)
+        {
+            const SERIAL_HANDLE handle = bag->GetChildSerial(slot);
+            CNtlSobItem* item = Fuel_GetOwned(handle, place, position);
+            if (!item || LocalFuelIdentity(reinterpret_cast<CNtlSobItemAttr*>(item->GetSobAttr())) != saved) continue;
+            if (selected != INVALID_SERIAL_ID) return; // ambiguous: never choose the first copy
+            selected = handle;
+        }
+    }
+    if (selected != INVALID_SERIAL_ID) Fuel_CanRegister(selected);
+}
+
+void CVehicleGui::Fuel_ClearPreference()
+{
+    if (Fuel_MatchesContext() && GetNtlStorageManager()->SetData(dSTORAGE_CHARACTER_FUEL_RESTORE, "none"))
+        Logic_SaveCharacterOption();
+}
