diff --git a/DboClient/Lib/Ntl_Plugin_World/src/bafrmlock.c b/DboClient/Lib/Ntl_Plugin_World/src/bafrmlock.c
new file mode 100644
--- /dev/null
+++ b/DboClient/Lib/Ntl_Plugin_World/src/bafrmlock.c
@@ -0,0 +1,48 @@
+/*
+ * Dirty frame list locking derived from OpenDBO PR #136 by riagoncalves.
+ * Upstream head: ba3f1e521991430f9b1133e00e2bb629c1bec548.
+ * Local reinforcement: initialize once and keep the recursive lock alive for
+ * the process. Engine Close cannot delete/disable it under an active caller.
+ * This protects list operations, not general frame/engine object lifetimes.
+ */
+#include <windows.h>
+#include "bafrmlock.h"
+
+static INIT_ONCE frameDirtyListOnce = INIT_ONCE_STATIC_INIT;
+static CRITICAL_SECTION frameDirtyListLock;
+
+static BOOL CALLBACK
+FrameDirtyListInitialize(PINIT_ONCE once, PVOID parameter, PVOID *context)
+{
+    (void)once;
+    (void)parameter;
+    (void)context;
+    InitializeCriticalSection(&frameDirtyListLock);
+    return TRUE;
+}
+
+void
+_rwFrameDirtyListLockOpen(void)
+{
+    InitOnceExecuteOnce(&frameDirtyListOnce, FrameDirtyListInitialize, NULL, NULL);
+}
+
+void
+_rwFrameDirtyListLockClose(void)
+{
+    /* Process lifetime: workers must still stop before engine/frame teardown. */
+}
+
+void
+_rwFrameDirtyListLock(void)
+{
+    _rwFrameDirtyListLockOpen();
+    /* Recursive: sync callbacks may dirty other frames on this thread. */
+    EnterCriticalSection(&frameDirtyListLock);
+}
+
+void
+_rwFrameDirtyListUnlock(void)
+{
+    LeaveCriticalSection(&frameDirtyListLock);
+}
